      "routeKeys": {
        "nxtPcaminho": "nxtPcaminho"
      },
      "namedRegex": "^/uploads/(?<nxtPcaminho>.+?)(?:/)?$"
    },
    {
      "page": "/[categoria]/[slug]",
      "regex": "^/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategoria": "nxtPcategoria",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPcategoria>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
