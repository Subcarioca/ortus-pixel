d:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsMediaOrganization\",\"name\":\"Ortus Pixel\",\"url\":\"http://localhost:3000\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"http://localhost:3000/logo.png\",\"width\":600,\"height\":60},\"sameAs\":[\"https://x.com/ortuspixel\",\"https://www.instagram.com/ortuspixel\",\"https://www.tiktok.com/@ortuspixel\",\"https://www.youtube.com/@ortuspixel\"]}"}}]
