$","$L3",null,{"href":"/redacao","children":"Nossa redação"}]}],["$","li",null,{"children":["$","$L3",null,{"href":"/metodologia","children":"Como escolhemos o que publicar"}]}],["$","li",null,{"children":["$","$L3",null,{"href":"/admin","children":"Acesso da redação"}]}]]}]]}]]}],["$","div",null,{"className":"footer__bottom","children":[["$","$L10",null,{}],["$","p",null,{"className":"note","children":[["$","strong",null,{"children":"Transparência:"}]," a ","Ortus Pixel"," usa publicidade e links de afiliado. Nenhum dos dois influencia a posição de uma notícia no ranking de temperatura."," ",["$","$L3",null,{"href":"/politica-de-afiliados","children":"Política de afiliados e publicidade"}]]}]]}],["$","p",null,{"className":"footer__legal","children":["© ",2026," ","Ortus Pixel"," · Todos os direitos reservados · Marcas e imagens pertencem aos seus respectivos detentores."]}]]}]}]
