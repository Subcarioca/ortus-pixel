// =============================================================================
// MODELO DE DADOS DO CANALNERD
// =============================================================================
//
// Banco escolhido: MySQL/MariaDB. O motivo de ser RELACIONAL não mudou desde o
// ADR 0002 — mudou só o fornecedor:
//   - O domínio é fortemente relacional: artigo N:N franquia, artigo N:N tag,
//     score 1:N histórico. Em documento, "todos os artigos da franquia X
//     ordenados por score" vira agregação cara ou duplicação de dados.
//   - Precisamos de séries temporais de score com consultas por janela
//     (últimas 24h). Índices B-tree compostos resolvem isso muito bem.
//   - `Json` cobre a parte genuinamente sem esquema (payload bruto de sinal),
//     então não pagamos o preço de um segundo banco só por isso. No MariaDB
//     `Json` é um `LONGTEXT` com validação; o Prisma Client serializa e
//     desserializa exatamente como fazia com o `jsonb`.
//
// POR QUE SAÍMOS DO POSTGRES (Neon) — ver design/plano-migracao-mysql-2026-08.md:
//   - O site roda em HOSPEDAGEM COMPARTILHADA da Hostinger, e o MySQL da mesma
//     conta é, para efeitos práticos, local. Toda consulta deixa de atravessar a
//     internet pública para chegar ao banco.
//   - O free tier da Neon SUSPENDE o compute após 5 min ociosos, e o autosuspend
//     não é desativável no plano gratuito. Num portal recém-lançado — ocioso a
//     maior parte do dia — isso significava 300 ms a 1 s de tela BRANCA em boa
//     parte das primeiras visitas, porque as páginas são renderizadas no
//     servidor. Era a maior degradação visível para o leitor, e some aqui.
//   - Custo: o MySQL já está incluso e pago no plano de hospedagem.
//
// O QUE ESSA TROCA CUSTOU, registrado sem maquiagem (§9.1 do plano):
//   - A BUSCA PIORA. Perdemos o `tsvector` com dicionário de português, ou seja,
//     a radicalização que ligava "jogos" a "jogo" sozinha. O substituto é
//     `FULLTEXT` em modo booleano com prefixo (`jogo*`), que cobre o caso
//     dominante mas não é equivalente. Ver o comentário do model `Article`.
//   - Termos de 2 letras ("IA", "PS", "3D") não entram no índice do InnoDB
//     (`innodb_ft_min_token_size` = 3, imutável em hospedagem compartilhada).
//     Existe um fallback `LIKE` em `searchContent` justamente para eles.
//   - Em compensação, ACENTO deixa de importar: "lancamento" passa a achar
//     "lançamento" — uma limitação que o Postgres tinha e que era documentada
//     como conhecida e aceita.
//     A collation REAL do servidor é `utf8mb4_unicode_ci` (conferida coluna a
//     coluna em `information_schema.COLUMNS`, não presumida — o plano supunha
//     `utf8mb4_uca1400_ai_ci`, que NÃO é a que está lá). O que importa é o
//     comportamento, e ele foi medido: `'lancamento' = 'lançamento'` e
//     `'Zelda' = 'zelda'` devolvem verdadeiro. Ou seja, insensível a caixa E a
//     acento, que é exatamente a propriedade da qual dependemos — tanto na
//     busca quanto na remoção do `mode: 'insensitive'`.
//     ⚠ Se algum dia a collation for alterada para uma `_as_` (accent
//     sensitive), a busca por "lancamento" para de achar "lançamento" e os
//     `contains` de franquia e editoria voltam a ser sensíveis a acento, sem
//     que nenhuma linha de código mude.
//   - Ficamos PRESOS no Prisma 6: o Prisma 7 gera SQL específico do MySQL 8 que
//     o MariaDB rejeita (prisma/prisma#29023). As versões estão FIXADAS em
//     packages/db/package.json de propósito — leia o comentário de lá antes de
//     subir qualquer uma das duas.
//
// CONSEQUÊNCIAS DE SINTAXE QUE VALE SABER ANTES DE EDITAR ESTE ARQUIVO:
//   - `String` no conector MySQL vira `VARCHAR(191)` POR PADRÃO, e o MySQL com
//     `sql_mode` estrito NÃO trunca em silêncio: dá erro 1406 e a escrita FALHA.
//     Por isso este schema agora tem anotações `@db.Text` e `@db.VarChar(N)`
//     explícitas em todo campo de texto livre, URL ou user-agent. Ao acrescentar
//     um campo novo, pergunte "um humano digita isto livremente? é uma URL?" —
//     se sim, ele precisa de anotação. Sem ela, o bug aparece em produção, na
//     forma de um editor clicando em Publicar e recebendo erro 500.
//   - `String[]` NÃO EXISTE em MySQL. Os campos que eram array viraram `Json`
//     com `@default("[]")`; o Prisma Client continua devolvendo array JS, mas os
//     filtros `has`/`isEmpty`/`hasSome` do conector Postgres deixaram de existir.
//   - `@@index(campo(sort: Desc))` é ACEITO E IGNORADO pelo MariaDB
//     (MDEV-13756). Os índices continuam servindo; o InnoDB apenas varre ao
//     contrário. Custo pequeno nesta escala, mas não presuma que o índice é
//     descendente de verdade só porque o schema diz que é.
//
// CONVENÇÕES ADOTADAS:
//   - `cuid()` como chave primária em vez de autoincremento: IDs sequenciais
//     vazam volume de negócio (o concorrente lê /article/1042 e sabe quantas
//     matérias publicamos) e atrapalham inserção distribuída.
//   - Todo campo consultado em listagem tem índice explícito. Este portal vive
//     de ordenação por score e por data; sem índice, a home degrada exatamente
//     no pico de tráfego, que é quando ela não pode degradar.
//   - Datas sempre em UTC; a conversão para o fuso do leitor é feita na borda.

generator client {
  provider      = "prisma-client-js"
  // "native" mantém o dev local (Windows/Mac) funcionando; os demais cobrem
  // as variantes mais comuns de hospedagem Linux (Hostinger inclusive) —
  // sem isso, um build feito localmente no Windows gera só o engine do
  // Windows, que não roda no servidor de produção.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  // "mysql" cobre também o MariaDB — o Prisma não tem conector separado para
  // ele. O servidor real é um MariaDB 11.8 da Hostinger, e essa distinção
  // importa em três pontos concretos, todos já sentidos neste schema:
  //   1. índice descendente é aceito e ignorado (MDEV-13756);
  //   2. o Prisma 7 quebra com MariaDB (#29023) — versões fixadas no package.json;
  //   3. `@@fulltext` do Prisma existe, mas atrás de um preview feature que não
  //      queremos ligar; os quatro índices FULLTEXT da busca são criados por SQL
  //      à mão, em prisma/migrations-manual/. Ver o comentário do model Article.
  provider = "mysql"

  // A URL inteira vem do ambiente, jamais do repositório.
  //
  // ⚠ ESTE ARQUIVO É PUBLICADO como pacote (`publishConfig` em package.json).
  // Por isso ele NÃO nomeia servidor, conta de hospedagem nem banco: um hostname
  // e um identificador de conta não são segredo por si sós, mas publicá-los
  // entrega de graça metade do trabalho de reconhecimento de quem for tentar
  // força bruta contra o MySQL — e não custa nada mantê-los fora daqui.
  // O procedimento completo de montar a `DATABASE_URL`, com os cuidados que já
  // custaram tempo (host que não resolve, TLS, limite de pool), está em
  // `.env.example`, que fica no repositório e não é publicado.
  url = env("DATABASE_URL")
}

// =============================================================================
// TAXONOMIA — categorias, franquias e tags
// =============================================================================

model Category {
  id          String @id @default(cuid())
  // O slug é a URL pública (/categoria/games). `@unique` porque a URL é
  // identidade: duas categorias com o mesmo slug seria conteúdo duplicado,
  // que o Google pune.
  slug        String @unique
  name        String
  shortName   String
  // `@db.Text`: texto livre editorial. Cabe hoje em 191, mas o dia em que
  // couber é o dia em que a tela de editorias devolve erro 500 ao salvar.
  description String @db.Text
  accentColor String @default("#7C3AED")

  // Prioridade de monitoramento (1 = máxima). O pipeline usa para alocar o
  // orçamento de chamadas de API quando a quota aperta.
  monitoringPriority Int   @default(5)
  launchPhase        Int   @default(1)
  affiliateWeight    Float @default(0.5)

  // Campos de SEO sobrescrevíveis. Quando nulos, o front gera a partir de
  // name/description — ter o override permite ao editor otimizar sem deploy.
  // `VarChar(255)` no título (é a `<title>`, tem limite prático) e `Text` na
  // descrição, que o editor escreve à vontade.
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.Text

  articles      Article[]
  topics        Topic[]
  franchises    Franchise[]
  subcategories Subcategory[]
  /// Leitores que seguem esta editoria. Ver `CategoryFollow`.
  follows       CategoryFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monitoringPriority])
}

/// Sub-categoria de UM nível dentro de uma editoria. Hoje: Hardware ⊂ Tech.
///
/// POR QUE UMA TABELA, E NÃO UMA TAG (ver core/taxonomy.ts para o racional
/// completo): a sub-categoria tem URL indexável própria
/// (/categoria/tech/hardware), entra no menu e precisa ser FILTRÁVEL por chave
/// estrangeira. Filtrar "todos os artigos de hardware" por texto de tag é lento,
/// frágil (basta alguém escrever "Hardwares") e não sobrevive a renomeação.
///
/// Assim como as categorias, vive no código (`SUBCATEGORIES` em core/taxonomy)
/// e é MATERIALIZADA aqui pelo seed — o mesmo padrão de "seed tipado", pelos
/// mesmos motivos: são poucas, estáveis e mudam junto com rota e menu.
model Subcategory {
  id          String @id @default(cuid())
  /// Único DENTRO da categoria-mãe, não globalmente: no futuro pode existir
  /// "hardware" em Tech e "hardware" em Games sem colisão de identidade.
  slug        String
  name        String
  description String @default("") @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Ver comentário em Category.affiliateWeight: controla SÓ densidade de bloco
  /// na UI e priorização humana de pauta. NUNCA entra no cálculo de score.
  affiliateWeight Float @default(0.5)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([slug])
}

/// Franquia/fandom (Star Wars, Zelda, One Piece). Motor de retenção do produto.
model Franchise {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @default("") @db.Text

  /// Nomes alternativos usados pelos conectores para casar menções.
  ///
  /// `Json` (era `String[]` no Postgres, que tem array nativo; MySQL não tem).
  /// A troca é de TIPO, não de comportamento: o Prisma Client continua entregando
  /// um array de strings ao TypeScript, e o curator continua fazendo
  /// `[franchise.name, ...franchise.aliases]` sem saber da diferença.
  ///
  /// O que se PERDE: os filtros de array do conector Postgres (`has`, `hasSome`,
  /// `isEmpty`) deixam de existir. Aqui não custa nada — este campo é sempre
  /// lido junto do pai, como bloco, e nunca filtrado dentro do banco. Se um dia
  /// precisar ser, a resposta é uma tabela de junção, não `JSON_CONTAINS` (que
  /// não usa índice e varre a tabela inteira).
  ///
  /// O `@default("[]")` é declarado aqui e o Prisma Client o aplica, mas ATENÇÃO:
  /// por um bug conhecido (prisma#23250) ele NÃO chega ao banco no conector
  /// MySQL. Consequência prática: todo `INSERT` feito por SQL cru precisa passar
  /// o valor explicitamente, senão viola o NOT NULL.
  aliases Json @default("[]")

  // -----------------------------------------------------------------------------
  // `VarChar(2048)` É O NÚMERO DE TODAS AS COLUNAS DE URL DESTE SCHEMA.
  //
  // Não é escolha estética: 2048 é EXATAMENTE o teto que o validador aplica
  // (`apps/web/src/lib/safe-url.ts`, "URL gigante é sintoma de payload, não de
  // link"). Validador e coluna precisam concordar, e a razão é o modo de falha
  // quando discordam: o servidor NÃO está em `sql_mode` estrito, então uma URL
  // aceita pela validação e maior que a coluna não dá erro — ela é TRUNCADA em
  // silêncio. O resultado é um link quebrado que ninguém reporta porque ninguém
  // vê nada de errado acontecer.
  //
  // (A primeira versão desta migração usou 1024, que era metade do validador.
  // O erro só apareceu numa auditoria cruzando validador com coluna, campo a
  // campo — motivo pelo qual o número está escrito aqui, e não deduzido.)
  //
  // Não é `Text` porque URL tem limite prático conhecido, e `Text` não é
  // indexável sem prefixo. Não estoura o limite de linha do InnoDB: no row
  // format DYNAMIC, um VARCHAR longo é guardado fora da página, deixando só um
  // ponteiro de 20 bytes na linha.
  // -----------------------------------------------------------------------------
  heroImageUrl String? @db.VarChar(2048)
  logoUrl      String? @db.VarChar(2048)

  primaryCategoryId String
  primaryCategory   Category @relation(fields: [primaryCategoryId], references: [id])

  /// Índice de afinidade da NOSSA audiência (1.0 = média do site).
  /// Recalculado por job a partir de pageviews/tempo de sessão históricos.
  /// É o sinal proprietário que nenhum concorrente consegue copiar.
  audienceAffinityIndex Float @default(1.0)
  followerCount         Int   @default(0)

  articles ArticleFranchise[]
  topics   TopicFranchise[]
  releases ReleaseEvent[]
  follows  FranchiseFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryCategoryId])
  @@index([audienceAffinityIndex])
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  /// 'character' | 'person' | 'studio' | 'event' | 'generic'
  kind     String       @default("generic")
  articles ArticleTag[]

  createdAt DateTime @default(now())

  @@index([kind])
}

// =============================================================================
// AUTORES — entidades de primeira classe por causa de E-E-A-T
// =============================================================================

/// Pessoa da redação. Model DUPLO, de propósito: é ao mesmo tempo a ASSINATURA
/// pública da matéria ("Marina Alves, Editora-chefe") e a CONTA que entra no
/// painel.
///
/// POR QUE NÃO SÃO DUAS TABELAS ("Author" público + "User" de login):
/// separá-las obrigaria a manter um vínculo 1:1 que nada garante — o dia em que
/// alguém criar uma conta sem autor (ou o contrário), o painel passa a ter um
/// usuário que não consegue assinar nada, ou uma assinatura que ninguém
/// consegue editar. Aqui, `Article.authorId` aponta para a MESMA linha que a
/// sessão do painel identifica, e é isso que faz a regra "redator só mexe no que
/// é dele" ser uma comparação de igualdade, e não um join especulativo.
model Author {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  /// E-mail: identidade pública E login do painel. Guardado sempre em
  /// minúsculas (normalizado na escrita) — senão "Marina@..." e "marina@..."
  /// viram duas contas, e o índice único não impede porque são strings
  /// diferentes.
  ///
  /// `VarChar(255)` para casar com o validador: `server/security.ts` aceita
  /// e-mail de até 254 caracteres (o limite da RFC 5321), e a coluna no padrão
  /// do Prisma teria 191. Sem isto, um endereço longo e perfeitamente válido
  /// passaria pela validação e seria TRUNCADO em silêncio no banco (o servidor
  /// não está em `sql_mode` estrito) — criando uma conta cujo e-mail de login
  /// não é o que a pessoa digitou. 255 × 4 bytes = 1.020, bem abaixo do teto de
  /// 3.072 do InnoDB, então o índice `@unique` continua cabendo.
  email     String  @unique @db.VarChar(255)
  bio       String  @default("") @db.Text
  avatarUrl String? @db.VarChar(2048)
  /// TÍTULO EDITORIAL, texto livre ("Editora-chefe", "Repórter de Games").
  /// É apresentação: sai na assinatura da matéria e no `jobTitle` do
  /// schema.org/Person. NÃO tem relação com permissão — quem manda no acesso é
  /// `systemRole`, logo abaixo.
  role      String  @default("Redator")

  /// Links sociais e credenciais viram schema.org/Person com `sameAs`.
  /// É assim que o Google conecta o autor a uma identidade verificável — peça
  /// central de E-E-A-T em nicho de notícias.
  ///
  /// ⚠ O `@default("[]")` NÃO chega ao banco no conector MySQL (prisma#23250):
  /// a coluna nasce `NOT NULL` e sem default. Pela aplicação isso é invisível (o
  /// Prisma Client conhece o default e o envia), mas qualquer `INSERT` por SQL
  /// cru — inclusive o script de migração de dados — precisa passar `[]`
  /// explicitamente, senão a linha é rejeitada.
  socialLinks Json @default("[]")

  /// Editorias em que este autor tem expertise declarada (E-E-A-T).
  /// Era `String[]`; virou `Json` pelo mesmo motivo e com as mesmas
  /// consequências descritas em `Franchise.aliases`. Continua sendo lido como
  /// array em `db/src/mappers.ts`, que filtra por `isCategorySlug` — e essa
  /// validação na borda passa a valer DOBRADO: `Json` aceita qualquer forma, e
  /// quem garante que só entra slug de categoria é o mapper, não mais o banco.
  expertiseAreas Json @default("[]")

  /// NÍVEL DE ACESSO ao painel. Vocabulário fechado: 'admin' | 'redator'.
  ///
  /// A validação vive em `core/staff.ts` (`isAccessLevel`), no mesmo padrão de
  /// `status`, `format` e `currentBand`: `String` no banco + union no domínio.
  /// Não é `enum` do Prisma porque nenhum outro vocabulário fechado deste schema
  /// é — e um enum isolado significaria duas gramáticas convivendo, com a
  /// migração de cada valor novo mudando de natureza dependendo do campo.
  ///
  ///   admin   → vê e edita TUDO, gerencia contas, modera, mexe no comercial.
  ///   redator → cria/edita/apaga apenas as matérias em que ele é o autor.
  ///
  /// O padrão é o MENOS privilegiado: uma conta criada por engano (ou por um
  /// caminho de código que esqueça de passar o campo) nasce sem poder algum.
  systemRole String @default("redator")

  /// Hash da senha no formato `scrypt$N$r$p$sal$hash` (ver packages/db/src/password.ts).
  ///
  /// NULO é estado legítimo e importante: significa "esta pessoa assina matéria,
  /// mas não tem acesso ao painel". É o que permite ter um colaborador externo
  /// como autor sem lhe dar uma conta — e é o estado em que ficam os autores que
  /// existiam antes deste sistema. Sem senha, a rota de login recusa SEMPRE,
  /// mesmo que o e-mail exista.
  ///
  /// `VarChar(255)` é margem de segurança barata, não necessidade de hoje: o
  /// formato atual cabe folgado em 191. Mas o comprimento depende dos parâmetros
  /// do scrypt (N, r, p) e do tamanho do sal — subir o custo do KDF, que é uma
  /// mudança de UMA LINHA em password.ts e a coisa certa a fazer com o tempo,
  /// alongaria o hash. E o modo de falha aqui é dos piores: sem `sql_mode`
  /// estrito, o servidor TRUNCA em silêncio (ver o cabeçalho do arquivo). Um
  /// hash truncado não dá erro nenhum — ele simplesmente nunca mais confere, e o
  /// sintoma é "trocaram minha senha" para toda a redação de uma vez.
  passwordHash String? @db.VarChar(255)

  /// Desligar > apagar. Apagar um autor exigiria decidir o que fazer com as
  /// matérias assinadas por ele (a FK é obrigatória em `Article.authorId`), e
  /// "some com a assinatura de tudo que ele escreveu" nunca é a resposta certa
  /// num veículo jornalístico. Conta inativa não entra e não aparece como opção
  /// de autor em matéria nova; o que ela já assinou continua no ar.
  isActive Boolean @default(true)

  /// Última entrada no painel. Serve à tela de contas ("esta conta é usada?") e
  /// a uma auditoria simples de acesso. Nulo = nunca entrou.
  lastLoginAt DateTime?

  articles      Article[]
  auditLogs     AuditLog[]
  staffSessions StaffSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice da tela de contas e da rota de login: filtramos por nível e por
  // atividade em toda listagem administrativa.
  @@index([systemRole, isActive])
}

/// Sessão de quem está logado no PAINEL.
///
/// Tabela separada de `CommentSession` (a sessão do leitor), e não uma coluna a
/// mais nela. O motivo é o mesmo que já separava os dois cookies: um bug no
/// login social de comentários não pode, em hipótese nenhuma, abrir a porta da
/// redação. Com uma tabela só, "sessão de leitor" e "sessão de staff" passariam
/// a ser distinguidas por um booleano — e um booleano esquecido num `where` é
/// uma escalada de privilégio.
///
/// O mecanismo é idêntico ao de `CommentSession` (token opaco de 256 bits no
/// cookie, SHA-256 no banco) pelas mesmas duas razões: revogação imediata
/// (desativar uma conta apaga as linhas e o acesso morre no clique seguinte, ao
/// contrário de um JWT, que vale até expirar) e vazamento contido (o banco só
/// tem hashes).
model StaffSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  // `VarChar(512)`: User-Agent moderno de Chrome/Edge passa de 191 com folga.
  // Truncar aqui não quebraria login, mas estragaria a auditoria de acesso —
  // que é a única razão de o campo existir.
  userAgent String?  @db.VarChar(512)
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([authorId])
  // Suporta a limpeza periódica de sessões expiradas.
  @@index([expiresAt])
}

// =============================================================================
// TÓPICOS — o que o pipeline descobre antes de existir artigo
// =============================================================================

/// Um TÓPICO é um fato do mundo detectado pelo pipeline.
/// Um ARTIGO é o nosso conteúdo sobre ele. Ver comentário em core/domain.ts
/// para o motivo de serem tabelas separadas.
model Topic {
  id String @id @default(cuid())

  /// DE ONDE VEIO ESTA PAUTA: 'curator' (o pipeline achou) ou 'manual' (alguém
  /// da redação criou pelo painel).
  ///
  /// POR QUE UMA COLUNA, E NÃO UMA TABELA `ManualTopic` SEPARADA: pauta é pauta.
  /// As duas viram matéria pelo mesmo fluxo (`create-article`), aparecem na
  /// mesma fila, competem pelo mesmo tempo da redação e são ordenadas pelo mesmo
  /// score. Duas tabelas obrigariam TODA leitura da fila a virar `UNION`, e a
  /// primeira consulta que alguém esquecesse de unir passaria a esconder metade
  /// do trabalho do dia — sem erro nenhum aparecer.
  ///
  /// O padrão é 'curator' porque é o que as linhas JÁ EXISTENTES são: o valor
  /// default é aplicado a elas na migração, e nenhum código que lê `Topic` hoje
  /// precisa saber que esta coluna existe.
  ///
  /// `VarChar(16)`: vocabulário fechado e curto (ver `core/topic-origin.ts`).
  /// Não é `enum` do Prisma pelo mesmo motivo dos outros vocabulários fechados
  /// deste schema — ver o comentário de `Author.systemRole`.
  origin String @default("curator") @db.VarChar(16)

  /// Quem criou a pauta manual. Nulo em tudo que veio do pipeline.
  ///
  /// String solta e não relação com `Author`: é o mesmo tratamento que
  /// `manualOverrideById` e `claimedById` já recebem neste model. Uniformidade
  /// aqui vale mais que a integridade referencial — e a integridade que importa
  /// (quem fez o quê) está em `AuditLog`, que sobrevive à remoção da conta.
  createdById String?

  /// Termo canônico usado nas consultas aos conectores.
  ///
  /// ⚠ `VarChar(255)` NÃO É ENFEITE — é o campo mais perigoso desta migração.
  /// `services/curator/src/pipeline/curate.ts` grava `item.title.slice(0, 200)`,
  /// ou seja, um valor que pode ter 200 caracteres: 9 a mais que o `VARCHAR(191)`
  /// que o Prisma usaria por padrão. Com o padrão, TODA manchete longa derrubaria
  /// a transação inteira do ciclo de curadoria com erro 1406 — dentro de um
  /// processo de fundo, onde ninguém veria o erro até o score parar de atualizar.
  query String @db.VarChar(255)

  /// Sinônimos do termo. Era `String[]`; ver `Franchise.aliases` para o racional
  /// completo da troca por `Json`.
  aliases Json @default("[]")

  // Manchete: passa de 191 com frequência em notícia de tecnologia.
  title   String @db.VarChar(255)
  // Resumo redigido: texto livre, sem limite prático.
  summary String @default("") @db.Text

  categoryId String?
  category   Category?        @relation(fields: [categoryId], references: [id])
  franchises TopicFranchise[]

  // ---- Proveniência ----
  // URL de feed/notícia com parâmetros de rastreio passa de 191 rotineiramente.
  sourceUrl  String? @db.VarChar(2048)
  sourceName String?
  /// Tier de autoridade da fonte: 'official' | 'tier1Press' | ... | 'unverified'
  sourceTier String  @default("unverified")

  /// Hash de deduplicação. Três feeds noticiando o mesmo anúncio precisam virar
  /// UM tópico, senão o mesmo assunto ocupa a home inteira e o orçamento de API
  /// é gasto três vezes. Ver services/curator/src/pipeline/dedupe.ts.
  dedupeHash String @unique

  // ---- Score (valores atuais, desnormalizados de propósito) ----
  //
  // Estes campos duplicam o último registro de ScoreSnapshot. É desnormalização
  // consciente: a home e o /trending ordenam por score a cada requisição, e
  // fazer isso com subquery no histórico seria caro justamente no pico de
  // tráfego. Gravamos os dois — histórico para análise, atual para leitura.
  currentScore        Float   @default(0)
  currentBand         String  @default("EVERGREEN")
  /// Variação do score na última hora (ver comentário equivalente em Article).
  scoreDelta1h        Float   @default(0)
  seoOpportunity      Float   @default(0)
  confidence          Float   @default(0)
  termType            String  @default("mid")
  /// Gatilhos emocionais detectados pelo motor de score ('leak', 'hype'...).
  /// Era `String[]`; ver `Franchise.aliases`. Lido só para exibição no painel
  /// (`admin/page.tsx` → `topic-row.tsx`), nunca filtrado no banco.
  emotionalTriggers   Json    @default("[]")
  requiresHumanReview Boolean @default(false)
  // Frase gerada explicando o score. Texto livre.
  scoreSummary        String  @default("") @db.Text
  weightsVersion      String  @default("")

  // ---- Override humano (o humano sempre vence o algoritmo) ----
  manualScoreOverride  Float?
  // Justificativa escrita por um editor: é exatamente o tipo de campo em que
  // alguém escreve um parágrafo. `Text`.
  manualOverrideReason String?   @db.Text
  manualOverrideById   String?
  manualOverrideAt     DateTime?

  /// 'new' | 'assigned' | 'published' | 'dismissed'
  status String @default("new")

  // ---- Instrumentação editorial (KPIs que analytics não fornece) ----
  firstSeenAt  DateTime  @default(now())
  lastScoredAt DateTime?
  /// Momento em que o score cruzou 80 pela primeira vez. É o T-zero do
  /// cronômetro de time-to-publish, o KPI editorial mais importante.
  becameHotAt  DateTime?
  /// Quando um jornalista assumiu a pauta.
  claimedAt    DateTime?
  claimedById  String?
  /// Quando o primeiro artigo derivado foi publicado.
  publishedAt  DateTime?

  // ---- Alerta de potencial viral (e-mail para a redação) ----
  //
  /// Quando o alerta "esta pauta tem cara de hit" foi ENVIADO por e-mail.
  ///
  /// ESTA COLUNA É O ANTIFLOOD, e ela é a razão de o alerta não ser calculado na
  /// hora do envio. O ciclo do curator recalcula score de minuto em minuto: sem
  /// uma marca persistida, todo recálculo que mantivesse o tópico acima do
  /// limiar mandaria um e-mail novo — e uma pauta quente por seis horas viraria
  /// setenta e duas mensagens para a redação inteira. O resultado previsível não
  /// é irritação: é a redação criando uma regra no Gmail que joga TODOS os
  /// alertas na lixeira, inclusive o que importava.
  ///
  /// Nulo = nunca alertado. Ver `server/viral-alert.ts` para a regra completa
  /// (inclusive o rearme, que é o que permite um segundo alerta legítimo dias
  /// depois sem transformar isto num "uma vez na vida").
  viralAlertSentAt DateTime?

  /// Faixa em que o tópico estava quando o alerta saiu ('HOT', 'RISING'...).
  ///
  /// Guardar a faixa, e não só o instante, é o que permite alertar DE NOVO
  /// quando o tópico SOBE mais uma faixa (RISING → HOT é notícia; HOT → HOT não
  /// é). Sem ela, a única política possível seria "um alerta por tópico para
  /// sempre" — e a subida que realmente importa passaria em silêncio.
  viralAlertBand String? @db.VarChar(16)

  articles       Article[]
  scoreSnapshots ScoreSnapshot[]
  signalReadings SignalReading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice principal do painel e do /trending: "tópicos ativos por score".
  @@index([status, currentScore(sort: Desc)])
  @@index([currentBand, becameHotAt])
  @@index([categoryId, currentScore(sort: Desc)])
  @@index([firstSeenAt])
}

model TopicFranchise {
  topicId     String
  franchiseId String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@id([topicId, franchiseId])
  @@index([franchiseId])
}

// =============================================================================
// HISTÓRICO DE SCORE E SINAIS — a memória que permite recalibrar
// =============================================================================

/// Fotografia do score num instante. Série temporal.
///
/// Guardamos TODOS os cálculos, não só as mudanças de faixa. É o que permite
/// reconstruir a curva de um tópico ("subiu de 40 para 85 em 2h") e reprocessar
/// o passado com pesos novos. É a tabela que mais cresce do sistema — a política
/// de retenção está documentada no README (resumo: detalhe por 90 dias, depois
/// agregado horário).
model ScoreSnapshot {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  score          Float
  band           String
  seoOpportunity Float
  confidence     Float

  /// Contribuição de cada dimensão, para o painel explicar o score.
  /// `Json` porque o conjunto de dimensões evolui com o tempo e não queremos
  /// migração de schema a cada sinal novo.
  contributions  Json
  weightsVersion String

  /// `true` quando este cálculo foi feito com pesos candidatos, em paralelo com
  /// os de produção (shadow scoring). Permite comparar modelos sem afetar o site.
  isShadow Boolean @default(false)

  calculatedAt DateTime @default(now())

  @@index([topicId, calculatedAt(sort: Desc)])
  @@index([calculatedAt])
  @@index([weightsVersion, isShadow])
}

/// Medição individual de um conector — o dado bruto, antes da agregação.
///
/// Por que guardar em nível tão granular? Duas razões concretas:
///  1) Depurar conector: "o Reddit está devolvendo 0 desde terça?"
///  2) Recalibrar com dados brutos, e não com valores já achatados pelos
///     pesos antigos — sem isso, a recalibração fica presa às escolhas passadas.
model SignalReading {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  connectorId String
  dimension   String
  value       Float
  // Ambos vêm de fora (resposta de API) ou de geração automática: não há
  // ninguém garantindo tamanho na origem. `Text` para não perder medição.
  rawValue    String? @db.Text
  confidence  Float
  explanation String? @db.Text

  /// Payload original da API, para auditoria e reprocessamento.
  rawPayload Json?

  observedAt DateTime @default(now())

  @@index([topicId, observedAt(sort: Desc)])
  @@index([connectorId, observedAt(sort: Desc)])
}

/// Saúde dos conectores — alimenta o circuit breaker e o painel de status.
model ConnectorHealth {
  id          String @id @default(cuid())
  connectorId String @unique

  isEnabled    Boolean @default(true)
  /// 'closed' = normal | 'open' = suspenso por falhas | 'half-open' = testando
  circuitState String  @default("closed")

  consecutiveFailures Int   @default(0)
  totalRuns           Int   @default(0)
  totalFailures       Int   @default(0)
  avgDurationMs       Float @default(0)

  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  // Mensagem de erro / stack trace. `Text`: um erro truncado em 191 é um erro
  // que não ajuda ninguém a depurar — e, pior, o truncamento em si viraria um
  // segundo erro (1406) escondendo o primeiro.
  lastError        String?   @db.Text
  /// Quando o circuito aberto deve ser testado novamente.
  circuitOpenUntil DateTime?

  /// Consumo do orçamento de chamadas pagas no ciclo corrente.
  callsThisPeriod Int       @default(0)
  periodResetAt   DateTime?

  updatedAt DateTime @updatedAt
}

// =============================================================================
// ARTIGOS
// =============================================================================

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  // Manchete. `VarChar(255)`: passa de 191 com frequência, e é uma das três
  // colunas do índice FULLTEXT da busca (ver o fim deste model).
  title   String @db.VarChar(255)
  excerpt String @default("") @db.Text
  /// Corpo em Markdown (ver ADR 0005).
  ///
  /// PAPEL NOVO DEPOIS DO EDITOR DE BLOCOS: quando `blocks` existe, esta coluna
  /// deixa de ser o que o leitor vê e passa a ser uma PROJEÇÃO EM TEXTO PURO dos
  /// blocos, gravada pelo servidor a cada salvamento. Ela continua existindo por
  /// dois motivos concretos, e nenhum deles é nostalgia:
  ///   1. é UMA DAS COLUNAS DO ÍNDICE FULLTEXT da busca — se o corpo saísse
  ///      daqui, toda matéria escrita em blocos ficaria invisível na busca do
  ///      site, sem nenhum erro aparecer em lugar nenhum;
  ///   2. é a rede de segurança de renderização: `blocks` nulo (as matérias
  ///      antigas) continua caindo no renderizador de Markdown de sempre.
  ///
  /// ⚠ POR QUE `MediumText` E NÃO `Text`, que seria o padrão para texto livre:
  /// `TEXT` no MySQL guarda 65.535 BYTES — não caracteres. O validador de
  /// entrada (`server/article-input.ts`) aceita até 20.000 CARACTERES neste
  /// campo. Em português puro isso dá uns 21 KB e caberia; mas `utf8mb4` gasta
  /// até 4 bytes por caractere, então 20.000 caracteres de emoji dão 80 KB e
  /// ESTOURAM o `TEXT`. O modo de falha seria o pior possível: erro 1406 na hora
  /// de publicar, numa matéria específica que ninguém consegue reproduzir.
  /// `MEDIUMTEXT` (16 MB) custa 1 byte a mais por linha e encerra a dúvida.
  content String @default("") @db.MediumText

  /// CORPO EM BLOCOS — array ORDENADO e tipado (ver packages/core/src/blocks.ts).
  ///
  /// POR QUE `Json` E NÃO UMA TABELA `ArticleBlock`:
  /// um bloco nunca é consultado sozinho. Não existe "buscar todas as citações
  /// do site", não existe ordenar por bloco, não existe permissão por bloco. O
  /// acesso é sempre "me dê o corpo INTEIRO desta matéria" — que em tabela
  /// própria vira um JOIN + ORDER BY por posição em toda leitura de artigo, com
  /// reordenação virando N updates de `position` numa transação. Em `Json` é uma
  /// coluna a mais no `select` que a página já faz, e reordenar é reescrever um
  /// array. O preço é não poder consultar por dentro; como nunca precisamos, o
  /// preço é zero.
  ///
  /// NULO ou array vazio = matéria escrita antes do editor de blocos. A página
  /// renderiza a partir de `content`, exatamente como sempre renderizou. Essa é
  /// a garantia que mantém as matérias já publicadas intactas.
  ///
  /// A FORMA é validada na ESCRITA (server/blocks-input.ts), nunca na leitura:
  /// dado que entra no banco já validado permite que o renderizador seja um
  /// `switch` simples. O renderizador ainda assim degrada em silêncio para um
  /// bloco desconhecido — banco é fronteira, e fronteira se trata com desconfiança.
  blocks Json?

  /// DE ONDE VEIO O TEXTO INICIAL: 'human' | 'ai-assisted'.
  /// Vocabulário fechado em packages/core/src/content-origin.ts.
  ///
  /// Gravado uma vez, na CRIAÇÃO, e nunca reescrito pela edição — a pergunta que
  /// ele responde é sobre a procedência do rascunho, e essa não muda depois de o
  /// redator reescrever por cima. É por isso que ele fica fora do
  /// `parseArticleInput` (que é a validação do FORMULÁRIO, chamada também na
  /// edição) e é lido diretamente pela rota de criação.
  ///
  /// NÃO É TRAVA DE PUBLICAÇÃO, de propósito: a trava é humana e anterior (a
  /// sugestão nasce como rascunho e alguém precisa clicar em publicar). Um campo
  /// que bloqueasse seria contornado deixando de marcá-lo, e aí ele deixaria de
  /// valer também como registro. Ver o cabeçalho de `content-origin.ts`.
  ///
  /// `VarChar(16)`: vocabulário curto e fechado, mesmo critério de
  /// `contentSensitivity`. Sem índice pelo mesmo motivo dela — nenhuma listagem
  /// filtra por este campo hoje; a auditoria que o consulta é rara e pode varrer.
  ///
  /// ⚠ COLUNA NOVA: exige `npm run db:push` (e, em banco novo, o
  /// `npm run db:fulltext` de sempre depois). O `@default("human")` é o que faz a
  /// coluna nascer correta nas linhas que já existem.
  contentOrigin String @default("human") @db.VarChar(16)

  /// 'suggested' | 'claimed' | 'draft' | 'in-review' | 'published' | 'archived'
  status String @default("draft")

  categoryId    String
  category      Category           @relation(fields: [categoryId], references: [id])
  /// Sub-categoria (ex.: Hardware dentro de Tech). Opcional: a maioria dos
  /// artigos vive direto na editoria.
  subcategoryId String?
  subcategory   Subcategory?       @relation(fields: [subcategoryId], references: [id])
  franchises    ArticleFranchise[]
  tags          ArticleTag[]

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  /// Tópico que originou o artigo. Opcional: matéria de pauta própria não vem
  /// do pipeline, e forçar um tópico sintético só sujaria os dados.
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  // URLs de CDN com parâmetros de transformação passam de 191 rotineiramente.
  coverImageUrl String? @db.VarChar(2048)
  // Texto alternativo: hoje o validador corta em 200, mas `VarChar(512)` dá
  // folga para o dia em que alguém afrouxar esse corte sem lembrar do banco.
  coverImageAlt String? @db.VarChar(512)

  /// Vídeo associado (trailer) — vira schema.org/VideoObject.
  videoUrl             String? @db.VarChar(2048)
  videoThumbnailUrl    String? @db.VarChar(2048)
  videoDurationSeconds Int?

  // ---- SEO ----
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.Text
  /// Canonical externo, para republicações licenciadas.
  canonicalUrl   String? @db.VarChar(2048)
  noIndex        Boolean @default(false)

  isBreaking     Boolean @default(false)
  readingMinutes Int     @default(1)

  // ---- Contrato de apresentação (exigido por design/README.md, seção 2) ----
  /// Formato do conteúdo: define o template do miolo no front.
  /// 'breaking' | 'live' | 'trailer' | 'review' | 'listicle' | 'theory'
  /// | 'comparison' | 'guide'
  format String @default("breaking")

  /// Cobertura ao vivo em andamento: liga o ponto pulsante e a timeline.
  isLive       Boolean @default(false)
  updatesCount Int     @default(0)

  /// Liga o bloco de revelação por escolha (blur + "Mostrar mesmo assim").
  /// Prevenção de erro para o público de séries e anime.
  hasSpoiler Boolean @default(false)

  /// GRAU DE SENSIBILIDADE DO CONTEÚDO: 'none' | 'sensitive' | 'adult'.
  ///
  /// POR QUE TRÊS NÍVEIS E NÃO UM BOOLEANO `isAdult`: as consequências são
  /// diferentes, e um booleano obrigaria a escolher a errada para metade dos
  /// casos.
  ///
  ///   sensitive → tema pesado tratado jornalisticamente (violência real,
  ///               suicídio, abuso, tragédia). O leitor merece um aviso; o
  ///               anúncio automático continua sendo um risco de contexto
  ///               (banner de brinquedo ao lado de notícia de tragédia), então
  ///               a densidade cai, mas a matéria não sai do circuito.
  ///   adult     → conteúdo adulto propriamente dito. Fica FORA de toda
  ///               superfície monetizada por anúncio automático — não por
  ///               pudor, mas porque veicular AdSense em página adulta é
  ///               violação da política do programa, e a punição não é a página:
  ///               é a CONTA inteira, com todo o histórico de receita junto.
  ///
  /// A regra de quem pode BAIXAR este nível é de permissão, não de schema, e
  /// vive em `core/staff.ts` (`canLowerSensitivity`): qualquer pessoa da redação
  /// pode marcar como mais sensível; só administrador pode desmarcar. A
  /// assimetria é deliberada — errar para mais custa alguns centavos de receita,
  /// errar para menos custa a conta do AdSense.
  ///
  /// SEM ÍNDICE, de propósito: nenhuma listagem filtra por este campo hoje (a
  /// decisão é tomada ao RENDERIZAR a matéria, com a linha já em mãos), e cada
  /// `@@index` a mais em `Article` é custo em toda escrita de uma tabela que já
  /// carrega seis. Quando existir uma tela "matérias marcadas como adulto", aí
  /// sim o índice se paga.
  ///
  /// `VarChar(16)`: vocabulário fechado e curto (ver `core/content-sensitivity.ts`).
  contentSensitivity String @default("none") @db.VarChar(16)

  /// Resumo em 3 a 5 bullets. OBRIGATÓRIO em 'breaking' e 'review' — a
  /// validação vive em core/presentation.ts e é aplicada no painel editorial.
  ///
  /// Era `String[]`; virou `Json` (ver `Franchise.aliases`). É o array com mais
  /// pontos de leitura do projeto — `queries.ts`, a página do artigo e os dois
  /// formulários do admin —, e todos continuam tratando o valor como
  /// `string[]`. O que muda é DE ONDE vem essa garantia: antes era o tipo da
  /// coluna, agora é o `CardRow`/`toCardData` na borda de leitura. Por isso a
  /// leitura passa por um normalizador em vez de confiar no que vier do banco.
  tldr Json @default("[]")

  /// Dados de análise, quando format = 'review'. Json porque a estrutura
  /// (nota, prós, contras) só existe para um formato entre oito — colunas
  /// dedicadas ficariam nulas em 90% das linhas.
  reviewData Json?

  /// Atualizações da cobertura ao vivo (live blog).
  liveUpdates LiveUpdate[]

  // ---- Score ----
  /// Congelado no instante da publicação. É o "previsto" do KPI de precisão —
  /// e por isso NUNCA deve ser atualizado depois.
  scoreAtPublish Float?
  /// Score vivo, recalculado continuamente. Permite que um trailer que viralize
  /// 3h depois de publicado suba sozinho para o hero da home.
  currentScore   Float     @default(0)
  currentBand    String    @default("EVERGREEN")
  /// Variação do score na última hora. Alimenta a seta e o "+38" do design.
  /// Desnormalizado (em vez de calculado por subquery no histórico) porque a
  /// home exibe isso em todos os cards e a consulta roda a cada requisição
  /// não cacheada — justamente no pico de tráfego.
  scoreDelta1h   Float     @default(0)
  scoreUpdatedAt DateTime?

  // ---- Métricas reais (o "observado" do KPI de precisão) ----
  viewCount            Int    @default(0)
  /// Pageviews nas primeiras 24h. Congelado por job após a janela fechar.
  pageviews24h         Int?
  avgTimeOnPageSeconds Float?
  scrollDepthAvg       Float?
  shareCount           Int    @default(0)

  /// CURTIR + DESCURTIR SOMADOS — os dois têm O MESMO PESO na popularidade
  /// (decisão de produto: não é "like menos deslike", é engajamento total,
  /// incluindo polêmica). Ver model `ArticleReaction` logo abaixo.
  ///
  /// DESNORMALIZADO, e não um `COUNT(*)` em `ArticleReaction` na leitura: é o
  /// MESMO raciocínio já aplicado a `viewCount`/`shareCount` acima e a
  /// `Topic.currentScore`/`ScoreSnapshot` — a home e a página do artigo leem
  /// este número em toda requisição não cacheada (inclusive na seção "mais
  /// popular da semana"), e um `COUNT` por card seria caro justamente no pico
  /// de tráfego. Mantido pela mesma TRANSAÇÃO que grava/troca/remove a linha em
  /// `ArticleReaction` (ver `server/reactions.ts`) — sem transação, um erro no
  /// meio do caminho deixaria o contador mentindo para sempre, e nada no
  /// sistema o corrigiria depois (mesmo cuidado de `Franchise.followerCount`).
  reactionCount Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ---- Monetização (ver models AffiliateOffer / ArticleAffiliateOffer) ----
  /// DERIVADO da relação `affiliateOffers`. NUNCA editável pelo editor.
  ///
  /// A fonte da verdade é a RELAÇÃO; esta coluna é um índice desnormalizado,
  /// mantido exclusivamente por `syncAffiliateFlag()` em packages/db. Existe
  /// pelo mesmo motivo de `currentScore` no mesmo model: permitir filtrar
  /// "artigos com afiliado" em listagens sem um JOIN + COUNT por linha.
  ///
  /// Se algum dia esta coluna divergir da relação, quem vale é a relação — a
  /// camada de leitura recalcula o valor a partir dela ao montar o artigo.
  hasAffiliateLinks Boolean @default(false)

  affiliateOffers ArticleAffiliateOffer[]

  pushNotifications PushNotification[]
  comments          Comment[]
  reactions         ArticleReaction[]

  // ---------------------------------------------------------------------------
  // BUSCA — onde ficou o antigo `searchVector`
  // ---------------------------------------------------------------------------
  //
  // Não existe mais coluna de busca neste model, e isso é intencional.
  //
  // NO POSTGRES havia `searchVector Unsupported("tsvector")`, uma COLUNA GERADA
  // (`GENERATED ALWAYS AS ... STORED`) alimentada por `setweight` sobre
  // title/excerpt/content, com um índice GIN em cima. Três coisas morreram junto
  // com ela, e vale saber o que cada uma custou:
  //
  //   1. A GARANTIA DE SINCRONIA. A coluna gerada era impossível de
  //      dessincronizar: nenhum caminho de escrita conseguia esquecer de
  //      atualizá-la. O `FULLTEXT` do InnoDB tem a MESMA propriedade — ele é
  //      mantido pelo próprio banco a partir das colunas reais —, então esta
  //      garantia foi PRESERVADA, não perdida. É a razão de indexar
  //      title/excerpt/content diretamente em vez de manter uma coluna
  //      "searchText" atualizada pela aplicação.
  //
  //   2. O PESO POR CAMPO (`setweight` A/B/C). Não existe equivalente nativo.
  //      É EMULADO na consulta, somando três `MATCH` separados na proporção
  //      5 : 2 : 1 — que não é chute: são os pesos padrão do `ts_rank`
  //      (1.0 : 0.4 : 0.2) normalizados. Ver `searchContent` em
  //      apps/web/src/server/queries.ts.
  //
  //   3. A ARMADILHA DO `@default(dbgenerated())`. Ela existia só para impedir
  //      que o Prisma emitisse `ALTER COLUMN "searchVector" DROP DEFAULT` em
  //      toda migração futura. Sem coluna gerada, a armadilha some — este é o
  //      único efeito colateral francamente POSITIVO da migração de banco.
  //
  // OS QUATRO ÍNDICES `FULLTEXT` NÃO ESTÃO DECLARADOS AQUI de propósito: o
  // `@@fulltext` do Prisma exige ligar o preview feature `fullTextIndex`, e
  // preview feature em produção é dívida com data marcada. Eles são criados por
  // SQL à mão em prisma/migrations-manual/ — o mesmo padrão que a migração
  // antiga já usava para a coluna gerada. ⚠ Consequência que precisa ser
  // lembrada: `prisma db push` NÃO os cria e NÃO os remove. Depois de todo
  // `db push` em banco novo, rode `npm run db:fulltext`. Sem eles, a busca não
  // fica lenta: ela ERRA (`MATCH` sem índice é erro de SQL, não varredura).

  // Índice da home e das páginas de categoria: publicados, mais recentes.
  @@index([status, publishedAt(sort: Desc)])
  // Índice do hero/trending: publicados, maior score.
  @@index([status, currentScore(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  // Índice da aba de sub-categoria (/categoria/tech/hardware).
  @@index([subcategoryId, status, publishedAt(sort: Desc)])
  @@index([topicId])
  @@index([authorId])
}

model ArticleFranchise {
  articleId   String
  franchiseId String
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@id([articleId, franchiseId])
  // Índice do hub de franquia: "todos os artigos de Star Wars".
  @@index([franchiseId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// Atualização de cobertura ao vivo (live blog).
///
/// Tabela separada, e não um array de Json no artigo, por três motivos:
///  1) Cada atualização tem timestamp próprio e precisa ser ordenável.
///  2) Publicar uma atualização não pode reescrever o corpo inteiro do artigo
///     (que está em cache de CDN — reescrever invalidaria tudo a cada minuto).
///  3) Permite buscar "só as novidades desde X" para atualização incremental
///     no cliente, sem rebaixar a página inteira.
model LiveUpdate {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  content     String  @db.Text
  isHighlight Boolean @default(false)
  authorName  String?

  createdAt DateTime @default(now())

  @@index([articleId, createdAt(sort: Desc)])
}

// =============================================================================
// MONETIZAÇÃO — ofertas de afiliado
// =============================================================================
//
// PREMISSA DE MODELAGEM: a rede de afiliados AINDA NÃO FOI ESCOLHIDA.
//
// Isso muda tudo na hora de desenhar as tabelas. O erro clássico aqui é modelar
// em cima da primeira integração ("amazonAsin", "awinMerchantId") e descobrir,
// seis meses depois, que a metade do schema não serve para a rede escolhida —
// com dados de produção dentro. O custo dessa migração é alto e o prazo, ruim.
//
// A modelagem adotada é a do DADO EDITORIAL, não a do dado da rede:
//   - loja/varejista é TEXTO LIVRE (fase 1: o editor digita "Kabum");
//   - `network` e `externalId` já existem, vazios, esperando a fase 2, quando
//     um integrador passa a preencher e sincronizar preço por API;
//   - nada no schema pressupõe uma rede específica.
//
// Resultado: a fase 1 (cadastro manual pelo editor) e a fase 2 (sincronização
// automática) usam AS MESMAS TABELAS. Plugar a API não redesenha nada — só
// preenche colunas que já existem.

/// Oferta de produto com link de afiliado.
///
/// A oferta é uma entidade PRÓPRIA e não uma coluna do artigo, porque o mesmo
/// produto ("RTX 5090 na Loja X") aparece em vários artigos (review, comparativo,
/// "melhores placas de 2026"). Com colunas no artigo, atualizar o preço exigiria
/// achar e editar N artigos — e algum ficaria para trás, exibindo preço velho.
/// Aqui, atualiza-se UMA linha e todos os artigos acompanham.
model AffiliateOffer {
  id String @id @default(cuid())

  productName  String  @db.VarChar(512)
  /// Loja/varejista. Texto livre por decisão consciente (ver bloco acima).
  retailerName String
  brand        String?

  /// Preço em CENTAVOS, como inteiro.
  ///
  /// NUNCA `Float` para dinheiro: aritmética binária de ponto flutuante não
  /// representa 0,1 exatamente, e o erro se acumula em somas e comparações.
  /// Nulo é estado legítimo: "oferta cadastrada, preço ainda não conferido".
  priceCents Int?
  currency   String @default("BRL")

  /// URL final de afiliado (já com o código de rastreio do programa).
  /// Sanitizada na renderização — ver apps/web/src/lib/safe-url.ts.
  ///
  /// `VarChar(2048)` (o padrão de URL deste schema — ver `Franchise.heroImageUrl`):
  /// link de afiliado é, por natureza, das URLs mais longas que existem — leva ID
  /// de programa, de campanha e de sub-id encadeados. Cortar não daria erro de
  /// negócio visível: daria um link QUEBRADO, que é pior, porque a comissão
  /// simplesmente não é atribuída e ninguém percebe.
  offerUrl String @db.VarChar(2048)

  /// Categoria do PROGRAMA (hardware, console, jogo...). Ver core/monetization.
  programCategory String @default("outro")

  /// Rede de afiliados. Nulo na fase 1 (cadastro manual); preenchido na fase 2.
  network    String?
  /// Identificador do produto NA REDE (ASIN, SKU, offer id). Fase 2.
  externalId String?

  imageUrl     String? @db.VarChar(2048)
  /// 'in-stock' | 'out-of-stock' | 'unknown'
  availability String  @default("unknown")

  /// 'affiliate' | 'sponsored'.
  ///
  /// Hoje só usamos 'affiliate'. A coluna já aceita 'sponsored' porque o dono
  /// do site pediu que o schema não travasse a evolução para publieditorial —
  /// a LÓGICA de patrocinado não está implementada, só o vocabulário.
  disclosureKind String @default("affiliate")

  /// Quando o PREÇO foi atualizado pela última vez.
  ///
  /// Coluna separada de `updatedAt` de propósito. `updatedAt` responde "quando
  /// a linha mudou" (inclusive por uma correção de digitação no nome). O editor
  /// e o leitor precisam de outra resposta: "esse preço é de quando?".
  /// Misturar as duas faria uma correção de texto "rejuvenescer" um preço de
  /// três semanas atrás — exatamente o erro que este campo existe para evitar.
  priceUpdatedAt DateTime?
  /// Última verificação (mesmo sem mudança de preço). Fase 2, alimentado pelo job.
  lastCheckedAt  DateTime?

  /// Desligar > apagar: uma oferta encerrada precisa sumir do site sem levar
  /// junto o histórico de qual artigo a exibia (auditoria e prestação de contas).
  isActive Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  articles ArticleAffiliateOffer[]

  // Índice da tela de afiliados do painel: "ofertas ativas com preço mais velho
  // primeiro" — é a fila de trabalho do editor.
  @@index([isActive, priceUpdatedAt])
  @@index([programCategory])
  @@index([disclosureKind])
  @@index([network, externalId])
}

/// Vínculo N:N entre artigo e oferta.
///
/// Tabela de junção EXPLÍCITA (e não uma relação implícita do Prisma) porque o
/// vínculo carrega dados próprios: posição no bloco, destaque e quem vinculou.
/// Vínculo de afiliado é ação HUMANA e auditável — o `services/curator` (a
/// curadoria automática) não encosta nesta tabela.
model ArticleAffiliateOffer {
  articleId String
  offerId   String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  offer     AffiliateOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// Ordem de exibição no bloco. O editor decide o que vem primeiro — não o
  /// preço, não a comissão. Ordenar por comissão seria monetização governando
  /// conteúdo, que é justamente o que este projeto separa.
  position      Int     @default(0)
  /// "Nossa escolha": destaque visual dentro do bloco.
  isHighlighted Boolean @default(false)
  /// Rótulo curto opcional ("melhor custo-benefício", "top de linha").
  label         String?

  addedById String?
  createdAt DateTime @default(now())

  @@id([articleId, offerId])
  @@index([offerId])
  @@index([articleId, position])
}

// =============================================================================
// CALENDÁRIO DE LANÇAMENTOS — base própria para o sinal de sazonalidade
// =============================================================================

/// Datas conhecidas de estreias (filmes, jogos, temporadas de anime).
/// Alimenta o sinal `releaseProximity`: notícia perto de lançamento confirmado
/// vale mais. Também vira conteúdo próprio ("o que estreia em setembro").
model ReleaseEvent {
  id    String @id @default(cuid())
  // Título de estreia ("Temporada 3 de ... — episódio especial de fim de ano").
  title String @db.VarChar(255)
  slug  String @unique

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  /// 'movie' | 'series-season' | 'game' | 'anime-season' | 'comic' | 'event'
  kind String

  releaseDate DateTime
  /// `false` para datas anunciadas como "2027" ou janelas vagas — o sinal
  /// pondera menos quando a data não é firme.
  isConfirmed Boolean  @default(true)

  platform String?
  region   String  @default("BR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([releaseDate])
  @@index([franchiseId, releaseDate])
}

// =============================================================================
// FUNIL DE AUDIÊNCIA — newsletter, push, comunidade
// =============================================================================

/// Assinante de newsletter com DOUBLE OPT-IN.
///
/// SEGURANÇA E CONFORMIDADE (LGPD): o duplo opt-in não é firula de marketing.
/// Ele é (a) prova de consentimento, exigida pela LGPD, (b) proteção contra
/// cadastro malicioso de e-mails de terceiros e (c) o que mantém a reputação
/// de envio do domínio — sem ele, um bot inscreve mil endereços inválidos, os
/// bounces disparam e todo o domínio vai para spam.
model Subscriber {
  id    String @id @default(cuid())
  // `VarChar(255)` pelo mesmo motivo de `Author.email`: o validador aceita os
  // 254 caracteres da RFC 5321, e 191 truncaria em silêncio um endereço válido.
  // Aqui o estrago seria ainda mais discreto — o assinante nunca receberia o
  // e-mail de confirmação e o cadastro ficaria eternamente 'pending'.
  email String @unique @db.VarChar(255)

  /// 'pending' | 'confirmed' | 'unsubscribed' | 'bounced'
  status String @default("pending")

  /// Hash do token de confirmação (nunca o token em claro).
  /// Mesmo princípio de senha: se o banco vazar, o atacante não consegue
  /// confirmar inscrições alheias com os hashes.
  confirmationTokenHash String?
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?

  /// Token de descadastro, para o link de 1 clique exigido por lei/RFC 8058.
  unsubscribeTokenHash String?
  unsubscribedAt       DateTime?

  /// Preferências de conteúdo — franquias e categorias seguidas.
  /// Era `String[]`; ver `Franchise.aliases`. Hoje não existe caminho de escrita
  /// ativo para este campo, o que torna a troca de tipo inteiramente inócua aqui.
  preferredCategories Json @default("[]")

  // ---- Auditoria de consentimento (LGPD) ----
  /// IP e user-agent do momento do opt-in. Guardados por serem a prova do
  /// consentimento. IP é dado pessoal: incluído na política de retenção.
  signupIpHash    String?
  // `VarChar(512)`: um User-Agent truncado enfraquece justamente a PROVA do
  // consentimento, que é a única finalidade deste campo.
  signupUserAgent String? @db.VarChar(512)
  signupSource    String  @default("site")

  // ---- Métricas de engajamento ----
  emailsSent    Int       @default(0)
  emailsOpened  Int       @default(0)
  emailsClicked Int       @default(0)
  lastOpenedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Inscrição de Web Push (Push API / service worker).
model PushSubscription {
  id String @id @default(cuid())

  /// Endpoint único fornecido pelo navegador.
  ///
  /// ⚠ O CAMPO MAIS DELICADO DE DIMENSIONAR DESTE SCHEMA, porque é `@unique` —
  /// ou seja, precisa CABER NUM ÍNDICE. Endpoints de FCM e do Mozilla passam de
  /// 191 com folga, então o padrão do Prisma quebraria toda inscrição de push.
  /// E `Text` não resolve: o InnoDB não indexa `TEXT` sem prefixo declarado.
  /// A conta que fecha o número: 512 caracteres × 4 bytes (utf8mb4) = 2.048
  /// bytes, abaixo do teto de 3.072 do InnoDB com row format DYNAMIC. Sobra
  /// margem, e a coluna continua indexável.
  endpoint String @unique @db.VarChar(512)
  /// Chaves de criptografia da Push API. São específicas do par
  /// navegador+site e inúteis fora dele, mas ainda assim tratadas como segredo.
  p256dh   String
  auth     String

  userAgent String? @db.VarChar(512)

  /// Segmentação: só quero push de Games? Só de uma franquia?
  ///
  /// Eram `String[]`, e este é o ÚNICO array do projeto que era filtrado DENTRO
  /// do banco — `push-sender.ts` usava `{ isEmpty: true }` / `{ has: slug }`,
  /// filtros que só existem no conector Postgres. Com `Json` eles deixam de
  /// compilar, e a segmentação passou a ser feita EM MEMÓRIA (ver o comentário
  /// longo em apps/web/src/server/push-sender.ts, que explica a escolha).
  ///
  /// A régua para reabrir essa decisão está escrita lá: quando a base de push
  /// passar da casa das dezenas de milhares, o caminho é uma tabela de junção
  /// `PushSubscriptionCategory` — indexável de verdade —, não `JSON_CONTAINS`.
  preferredCategories Json @default("[]")
  preferredFranchises Json @default("[]")
  /// Só recebe push de score >= este valor. Padrão 80 = apenas QUENTE.
  minScoreThreshold   Int  @default(80)

  isActive      Boolean   @default(true)
  /// Endpoints expiram; após 410/404 do serviço de push, desativamos.
  lastFailureAt DateTime?
  failureCount  Int       @default(0)

  notificationsSent    Int @default(0)
  notificationsClicked Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries PushDelivery[]

  @@index([isActive, minScoreThreshold])
}

/// Campanha de push disparada para um artigo.
model PushNotification {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Título e corpo da notificação: derivam da manchete e do resumo da matéria,
  // então herdam o mesmo risco de tamanho deles.
  title   String  @db.VarChar(255)
  body    String  @db.VarChar(512)
  iconUrl String? @db.VarChar(2048)
  url     String  @db.VarChar(2048)

  /// 'automatic' = disparado pelo score | 'manual' = editor apertou o botão
  trigger        String  @default("manual")
  scoreAtTrigger Float?
  approvedById   String?

  /// 'pending' | 'sending' | 'sent' | 'failed'
  status String @default("pending")

  recipientCount Int @default(0)
  deliveredCount Int @default(0)
  clickedCount   Int @default(0)

  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  deliveries PushDelivery[]

  @@index([status, scheduledFor])
  @@index([articleId])
}

model PushDelivery {
  id             String           @id @default(cuid())
  notificationId String
  notification   PushNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// 'sent' | 'failed' | 'expired'
  status    String
  clickedAt DateTime?
  // Erro devolvido pelo serviço de push: vem de fora, sem limite garantido.
  error     String?   @db.Text
  createdAt DateTime  @default(now())

  @@unique([notificationId, subscriptionId])
  @@index([subscriptionId])
}

/// Leitor que segue uma franquia — sinal de retenção e base de segmentação.
///
/// SEGUIR NÃO EXIGE LOGIN. Ler o site nunca exigiu cadastro, e "crie uma conta
/// para seguir" é onde a intenção morre. Por isso existem DOIS sujeitos
/// possíveis para o mesmo follow:
///
///   - `visitorId`       — cookie anônimo. Sempre presente, inclusive para quem
///                         está logado (é o que permite seguir antes de logar e
///                         manter o follow depois).
///   - `commentAuthorId` — preenchido quando há sessão de leitor. É o que faz o
///                         follow sobreviver à troca de aparelho e à limpeza de
///                         cookies, e o que a página /minha-conta lista.
///
/// POR QUE UMA TABELA SÓ, E NÃO UMA PARA CADA CASO: "quem segue esta franquia"
/// e a contagem de seguidores viveriam de UNION entre duas tabelas para sempre,
/// e a migração de anônimo para logado (no login) viraria mover linha entre
/// tabelas em vez de um UPDATE de coluna.
///
/// AS DUAS CHAVES ÚNICAS FUNCIONAM PORQUE NULL É DISTINTO DE NULL dentro de um
/// índice único. Isso valia no Postgres e CONTINUA VALENDO no MySQL/MariaDB —
/// os dois se comportam igual neste ponto, então a migração de banco não mexeu
/// em nada aqui. Vale registrar justamente porque a versão anterior deste
/// comentário atribuía a propriedade ao Postgres, e alguém poderia "consertar"
/// o que não está quebrado. Consequência prática, que é exatamente o que
/// queremos e o que evitou índice parcial + CHECK escritos à mão:
///   - `[franchiseId, visitorId]`       impede o mesmo cookie seguir duas vezes;
///   - `[franchiseId, commentAuthorId]` impede a mesma CONTA seguir duas vezes,
///     e ao mesmo tempo NÃO restringe as linhas anônimas — cada uma tem
///     `commentAuthorId` nulo, e nulos não colidem entre si.
model FranchiseFollow {
  id          String    @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  /// Identificador anônimo do visitante (cookie primário). Continua obrigatório
  /// mesmo para leitor logado: é a origem do follow e o que permite reconciliar
  /// o que foi seguido antes do login.
  visitorId String

  /// Conta do leitor, quando ele está logado.
  ///
  /// `Cascade`: apagar a conta apaga os follows junto. Não é detalhe de
  /// arrumação — é o direito de eliminação da LGPD funcionando por construção,
  /// e não por alguém lembrar de limpar a tabela certa depois.
  commentAuthorId String?
  commentAuthor   CommentAuthor? @relation(fields: [commentAuthorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([franchiseId, visitorId])
  @@unique([franchiseId, commentAuthorId])
  @@index([visitorId])
  @@index([commentAuthorId])
}

/// Segue uma CATEGORIA (editoria — Games, Cinema, Anime...), em vez de uma
/// franquia específica. ESPELHA `FranchiseFollow` DE PROPÓSITO: mesmos dois
/// sujeitos possíveis (anônimo por cookie x conta logada), mesmo par de índices
/// únicos e pela mesma razão — ver o comentário de `FranchiseFollow` acima para
/// o racional completo. Não repetido aqui para não ter duas fontes de verdade
/// sobre a mesma decisão de design.
///
/// POR QUE UM MODEL PRÓPRIO, E NÃO REUSAR `FranchiseFollow` COM UM CAMPO
/// OPCIONAL A MAIS (`categoryId` ao lado de `franchiseId`, ambos nuláveis):
/// um follow "solto" (nem franquia, nem categoria) seria um estado inválido que
/// o schema permitiria e o código teria de vigiar em toda leitura e escrita.
/// Dois models pequenos, cada um com sua FK obrigatória, tornam esse estado
/// IRREPRESENTÁVEL — o banco garante a invariante, não um `if` esquecível.
model CategoryFollow {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Identificador anônimo do visitante (cookie primário). Ver o comentário
  /// equivalente em `FranchiseFollow`.
  visitorId String

  /// Conta do leitor, quando ele está logado. `Cascade`: apagar a conta apaga
  /// os follows junto (direito de eliminação da LGPD por construção).
  commentAuthorId String?
  commentAuthor   CommentAuthor? @relation(fields: [commentAuthorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([categoryId, visitorId])
  @@unique([categoryId, commentAuthorId])
  @@index([visitorId])
  @@index([commentAuthorId])
}

// =============================================================================
// REAÇÕES DE ARTIGO — curtir / descurtir, MESMO PESO
// =============================================================================
//
// DECISÃO DE PRODUTO (dono do site): curtir e descurtir têm O MESMO PESO na
// popularidade. Não é "like menos deslike" (que mediria consenso); os dois
// SOMAM (que mede ENGAJAMENTO — inclusive polêmica, que também é sinal de que
// a matéria importou). O agregado mora em `Article.reactionCount`, e o "por
// quê desnormalizado" está documentado junto daquele campo, não aqui.

/// Uma reação (curtir OU descurtir) de UM leitor logado em UMA matéria.
///
/// SÓ LEITOR LOGADO, ao contrário de `FranchiseFollow`/`CategoryFollow` (que
/// aceitam visitante anônimo): reagir é uma ação de baixíssimo atrito onde o
/// abuso por script (inflar reação de uma matéria) é barato demais sem uma
/// identidade por trás — a mesma razão pela qual comentar exige login. Seguir
/// uma franquia não tem esse risco (não altera nenhum ranking público),
/// reagir tem.
model ArticleReaction {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  commentAuthorId String
  commentAuthor   CommentAuthor @relation(fields: [commentAuthorId], references: [id], onDelete: Cascade)

  /// 'like' | 'dislike'. Vocabulário fechado e curto — mesmo tratamento de
  /// `Comment.status` e dos outros vocabulários pequenos deste schema.
  type String @db.VarChar(8)

  createdAt DateTime @default(now())

  /// UMA reação por (matéria, leitor). A rota é TOGGLE/REPLACE sobre esta
  /// restrição, nunca um `create` cego: curtir de novo quando já existe uma
  /// linha TROCA o tipo (curtiu quem tinha descurtido) ou APAGA a linha (clicou
  /// de novo no mesmo botão) — nunca acumula uma segunda linha para a mesma
  /// pessoa. Ver `server/reactions.ts`.
  @@unique([articleId, commentAuthorId])
  // Índice da consulta "reações de uma matéria" (moderação/auditoria). A
  // LEITURA de popularidade não usa este índice — ela lê o contador
  // desnormalizado em `Article.reactionCount`, sem tocar esta tabela.
  @@index([articleId])
}

// =============================================================================
// COMENTÁRIOS COM IDENTIDADE SOCIAL (Discord / Google)
// =============================================================================
//
// LGPD — MINIMIZAÇÃO DE DADOS é o princípio que desenha estas três tabelas.
// A pergunta feita em cada campo foi: "se este dado vazar amanhã, o que
// acontece com o leitor?" — e, antes dela: "a funcionalidade existe sem ele?".
// Ver o quadro completo em packages/core/src/community.ts.
//
// O que NÃO existe aqui, de propósito:
//   - token de acesso / refresh token do OAuth. Usamos o token uma vez, para
//     ler o perfil, e descartamos. Guardar token é guardar acesso à conta
//     alheia: risco enorme, valor zero para um sistema de comentários.
//   - ID bruto da conta no provedor. Só o hash. Precisamos RECONHECER a mesma
//     pessoa, não IDENTIFICÁ-LA fora do nosso site.
//   - e-mail em claro. Só o hash, e apenas para bloquear o reincidente que
//     volta pelo outro provedor.

/// Identidade de um leitor que comenta, vinda de um provedor OAuth.
model CommentAuthor {
  id String @id @default(cuid())

  /// 'discord' | 'google'
  provider            String
  /// HASH do ID da conta no provedor (com sal da aplicação).
  ///
  /// Por que hash e não o valor bruto: o ID do Discord/Google é um
  /// identificador estável e público-adjacente — com ele em claro, um vazamento
  /// do nosso banco permitiria cruzar cada comentário com o perfil real da
  /// pessoa em outras bases. Do nosso lado, tudo que precisamos é comparar
  /// igualdade ("é o mesmo sujeito de ontem?"), e hash faz isso perfeitamente.
  providerAccountHash String

  /// Nome público. Único dado pessoal guardado em claro — porque a finalidade
  /// (assinar o comentário) É exibi-lo.
  displayName String
  /// URL do avatar no CDN do provedor. Nunca baixamos nem re-hospedamos a
  /// imagem: isso criaria uma cópia de dado pessoal que teríamos de apagar
  /// depois, por nada.
  avatarUrl   String? @db.VarChar(2048)
  /// HASH do e-mail. Usado só para reconhecer reincidente banido que volta pelo
  /// outro provedor. Nunca para enviar e-mail — para isso existe o Subscriber,
  /// com consentimento próprio e double opt-in.
  emailHash   String?

  /// Bloqueio pela moderação. Bloqueado não posta e não vê botão de login.
  isBlocked   Boolean   @default(false)
  blockedAt   DateTime?
  // Motivo do bloqueio, escrito pela moderação. Texto livre — e é a prova
  // documental de uma decisão contestável. Truncar seria perder o argumento.
  blockReason String?   @db.Text

  /// Contadores de reputação — a base da "escada de confiança": o primeiro
  /// comentário de uma conta nova entra em moderação prévia; depois de
  /// aprovado, os seguintes publicam direto. É o que impede o drive-by de
  /// conta descartável sem transformar a redação em fila de aprovação.
  approvedCount Int @default(0)

  comments        Comment[]
  sessions        CommentSession[]
  /// Denúncias feitas por esta conta. Ver `CommentReport`.
  reports         CommentReport[]
  /// Franquias seguidas. É o único dado de PREFERÊNCIA que guardamos do leitor —
  /// e ele é declarado por ele, não inferido de comportamento.
  follows         FranchiseFollow[]
  /// Categorias (editorias) seguidas — mesmo papel de `follows`, ver
  /// `CategoryFollow`.
  categoryFollows CategoryFollow[]
  /// Curtidas/descurtidas em matéria — ver `ArticleReaction`.
  reactions       ArticleReaction[]

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // Identidade = (provedor, conta). O par é único; o mesmo humano com Discord
  // E Google vira duas linhas — e tudo bem: não somos rede social, não fundimos
  // identidades (fundir exigiria guardar mais dado pessoal, não menos).
  @@unique([provider, providerAccountHash])
  @@index([emailHash])
  @@index([isBlocked])
}

/// Sessão de leitor logado.
///
/// POR QUE SESSÃO OPACA NO BANCO, E NÃO JWT NO COOKIE:
/// o caso de uso mais importante da moderação é "bane esse sujeito AGORA".
/// Com JWT, o token continua válido até expirar — não há revogação sem manter
/// uma lista de bloqueio, que é um banco de sessões pior. Com sessão opaca,
/// apagar a linha encerra o acesso no próximo clique.
/// Guardamos o HASH do token, jamais o token: é o mesmo padrão já usado nos
/// tokens de newsletter (ver apps/web/src/server/security.ts).
model CommentSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  authorId String
  author   CommentAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  userAgent String?  @db.VarChar(512)
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([authorId])
  // Suporta a limpeza periódica de sessões expiradas.
  @@index([expiresAt])
}

/// Comentário.
model Comment {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Autor autenticado. Opcional apenas para não perder os comentários legados
  /// do modelo anterior (nome + e-mail); todo comentário NOVO exige login.
  authorAccountId String?
  authorAccount   CommentAuthor? @relation(fields: [authorAccountId], references: [id], onDelete: Cascade)

  /// Snapshot do nome no momento da publicação.
  ///
  /// Redundante com `CommentAuthor.displayName`? Não: se a pessoa trocar o nome
  /// no Discord para algo ofensivo, todos os comentários antigos dela mudariam
  /// retroativamente. O snapshot congela o que foi publicado — e a moderação
  /// continua conseguindo agir sobre a conta.
  authorName      String
  authorEmailHash String?
  /// Conteúdo em texto puro. NUNCA renderizar como HTML — ver ADR 0005 (XSS).
  ///
  /// `Text` e não `VarChar`: o validador já corta em 1.500 caracteres
  /// (`COMMENT_MAX_LENGTH`), o que caberia num `VARCHAR(1500)`. Mas o limite é
  /// uma regra de PRODUTO, que muda numa linha de código, e o banco não pode ser
  /// o lugar onde essa mudança explode em erro 1406 na cara do leitor.
  content         String  @db.Text

  /// 'pending' | 'approved' | 'rejected' | 'spam'
  status String @default("pending")

  // ---- Trilha de moderação ----
  /// Quem removeu/aprovou e por quê. Sem isso, "por que meu comentário sumiu?"
  /// não tem resposta, e uma remoção contestada vira palavra contra palavra.
  moderatedAt    DateTime?
  moderatedBy    String?
  moderationNote String?   @db.Text

  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  /// Hash do IP para rate limiting e antiabuso, sem guardar o IP em claro.
  ipHash  String?
  upvotes Int     @default(0)

  /// Denúncias recebidas. Ver `CommentReport`, logo abaixo.
  reports CommentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorAccountId])
}

/// DENÚNCIA DE COMENTÁRIO FEITA POR UM LEITOR.
///
/// -----------------------------------------------------------------------------
/// POR QUE UMA TABELA, E NÃO UM CONTADOR `reportCount` EM `Comment`
/// -----------------------------------------------------------------------------
/// Um contador responde "quantas?" e não responde a única pergunta que muda a
/// decisão da moderação: "quantas PESSOAS DIFERENTES?". Cinco denúncias de cinco
/// leitores é sinal; cinco da mesma conta é a própria denúncia sendo abusada
/// como arma para derrubar comentário alheio — e num contador as duas situações
/// são o mesmo número 5.
///
/// A tabela também é o que torna a chave única abaixo possível, e é ela que
/// impede o segundo caso de existir.
///
/// -----------------------------------------------------------------------------
/// LGPD — o mesmo raciocínio de minimização do cabeçalho desta seção
/// -----------------------------------------------------------------------------
/// Guardamos o MÍNIMO para a funcionalidade existir: quem denunciou (para não
/// contar duas vezes), o que foi denunciado e quando. Não há IP nem user-agent
/// aqui, ao contrário de `Comment`: a denúncia já exige conta autenticada, então
/// o antiabuso é feito por CONTA — o hash de IP seria dado pessoal guardado sem
/// nenhuma pergunta que ele responda.
///
/// `Cascade` no denunciante, e não `SetNull`, pela MESMA razão de
/// `Comment.authorAccountId` e `FranchiseFollow.commentAuthorId`: apagar a conta
/// apaga o que ela produziu. É o direito de eliminação funcionando por
/// construção, e não por alguém lembrar de limpar a tabela certa depois. O que
/// se perde — a contagem histórica encolhe quando uma conta some — é
/// irrelevante para o uso real, que é decidir sobre um comentário de agora.
model CommentReport {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  /// Conta do leitor que denunciou.
  ///
  /// Opcional apenas pela mesma razão de `Comment.authorAccountId`: manter a
  /// coluna nulável evita que uma futura denúncia de outra origem (um formulário
  /// de contato, por exemplo) precise de tabela nova. Hoje a rota EXIGE sessão —
  /// não existe caminho anônimo, e é isso que sustenta o limite por conta.
  reporterAccountId String?
  reporter          CommentAuthor? @relation(fields: [reporterAccountId], references: [id], onDelete: Cascade)

  /// Motivo, em texto curto e OPCIONAL.
  ///
  /// Opcional de propósito: exigir justificativa faria o leitor desistir no meio
  /// (é um clique contra um formulário), e a denúncia sem motivo já entrega o
  /// que importa — o ponteiro para um comentário que alguém achou grave. Quando
  /// vem preenchido, é o que a moderação lê primeiro.
  ///
  /// `VarChar(200)` e não `Text`: aqui o limite de produto e o do banco podem
  /// coincidir, porque este campo não é conteúdo editorial que cresce — é uma
  /// linha de justificativa. A rota corta antes de gravar.
  reason String? @db.VarChar(200)

  createdAt DateTime @default(now())

  /// A MESMA CONTA NÃO DENUNCIA O MESMO COMENTÁRIO DUAS VEZES.
  ///
  /// Sem esta chave, o limite por conta da rota (um contador em memória, que se
  /// perde a cada reinício e vive por instância) seria a única defesa contra
  /// alguém inflar a contagem de denúncias em looping até chamar a atenção da
  /// moderação. Aqui quem garante é o banco, para sempre.
  ///
  /// Ela também SERVE DE ÍNDICE por `commentId`: num índice composto, o banco
  /// usa o prefixo mais à esquerda: as consultas por comentário (a contagem na
  /// fila de moderação) passam por ela. Um `@@index([commentId])` separado seria
  /// uma segunda estrutura para manter na escrita sem nenhuma leitura nova.
  ///
  /// As linhas com `reporterAccountId` nulo não colidem entre si — NULL é
  /// distinto de NULL dentro de um índice único, tanto no MySQL quanto no
  /// Postgres (ver a nota longa em `FranchiseFollow`).
  @@unique([commentId, reporterAccountId])
  @@index([reporterAccountId])
}

// =============================================================================
// INSTRUMENTAÇÃO INTERNA — KPIs que o GA4 não entrega
// =============================================================================

/// EVENTO DE AUDIÊNCIA — o que o leitor fez, com granularidade de clique.
///
/// -----------------------------------------------------------------------------
/// POR QUE ESTA TABELA PRECISOU EXISTIR
/// -----------------------------------------------------------------------------
/// `Article` já tem `viewCount`, `pageviews24h`, `shareCount` e companhia. Eles
/// são CONTADORES AGREGADOS: respondem "quantas visitas?" e não respondem
/// NENHUMA das perguntas que a redação faz de verdade — "esta matéria puxou
/// gente para outras?", "o bloco de ofertas converte?", "vale manter anúncio no
/// meio do texto?". Um contador não se desagrega depois: a informação não foi
/// perdida, ela nunca existiu.
///
/// -----------------------------------------------------------------------------
/// TRÊS DECISÕES DE MODELAGEM QUE VÃO PARECER ERRADAS SEM ESTA EXPLICAÇÃO
/// -----------------------------------------------------------------------------
///
/// 1. NÃO HÁ CHAVE ESTRANGEIRA PARA `Article` NEM PARA `AffiliateOffer`.
///    É a decisão mais contraintuitiva do arquivo, e tem três motivos concretos:
///
///    (a) ESCRITA. Toda linha inserida com FK adquire um lock compartilhado na
///        linha-pai (o InnoDB precisa provar que ela existe). Esta é a tabela
///        mais escrita do sistema — uma matéria em alta gera milhares de
///        inserções por minuto, TODAS apontando para a MESMA linha de `Article`.
///        É a receita clássica de contenção num ponto único.
///    (b) REMOÇÃO. Com `onDelete: Cascade`, apagar uma matéria com 300 mil
///        eventos vira um `DELETE` de 300 mil linhas dentro da transação do
///        editor que clicou em "apagar" — que, na melhor hipótese, trava a tela
///        por minutos e, na pior, estoura o timeout e desfaz tudo.
///    (c) SIGNIFICADO. Este log é HISTÓRICO. "A matéria que apagamos em março
///        tinha 40 mil visitas" continua sendo verdade depois de a matéria
///        deixar de existir, e um `Cascade` apagaria justamente o registro de
///        que aquilo aconteceu.
///
///    O QUE SE PERDE, dito sem maquiagem: linhas órfãs (evento apontando para
///    matéria inexistente) passam a ser possíveis, e o banco não impede mais um
///    `articleId` inventado. Quem trata isso é a borda de escrita — a rota de
///    ingestão só grava id que ela mesma resolveu no banco — e a borda de
///    leitura, que faz `IN (...)` sobre os artigos que existem e ignora o resto.
///
/// 2. NÃO GUARDAMOS NADA DO LEITOR. Sem IP (nem em hash), sem user-agent, sem
///    identificador de visitante, sem `referer`. A consequência é conhecida e
///    aceita: NÃO dá para deduplicar "a mesma pessoa recarregou a página 5
///    vezes", então "visualizações" aqui é contagem de EVENTOS, não de gente.
///    Para a pergunta que esta tela responde — "qual matéria puxa mais que a
///    outra?" — a comparação relativa basta, e a alternativa custaria caro: um
///    identificador de visitante é dado pessoal sob a LGPD, com direito de
///    eliminação, base legal e política de retenção próprios. Não construímos
///    esse passivo para ganhar precisão que a decisão editorial não usa.
///
/// 3. A RETENÇÃO É PARTE DO DESENHO, NÃO UM PROBLEMA PARA DEPOIS. Esta tabela
///    cresce de forma linear com o tráfego e não tem teto natural. O caminho
///    previsto, na ordem: (i) hoje, consultas SEMPRE com janela de tempo (a tela
///    do painel usa 30 dias e o índice cobre isso); (ii) quando incomodar, um
///    job diário que agrega em `AnalyticsDaily` (uma linha por matéria/tipo/dia)
///    e APAGA o detalhe com mais de 90 dias — o mesmo caminho já documentado
///    para `ScoreSnapshot`. Nada no formato desta tabela atrapalha esse passo:
///    a agregação é um `GROUP BY` sobre as colunas que já existem.
model AnalyticsEvent {
  id String @id @default(cuid())

  /// O QUE aconteceu. Vocabulário fechado em `core/analytics.ts`:
  /// 'article.view' | 'article.link' | 'ad.click' | 'affiliate.click'.
  kind String @db.VarChar(24)

  /// A matéria ONDE o evento aconteceu. É a coluna que a tela do painel agrupa,
  /// e a que decide de quem é a métrica (a regra "redator só vê o que assina" é
  /// aplicada resolvendo os ids de matéria do autor ANTES da agregação).
  ///
  /// `VarChar(40)` e não o `VarChar(191)` padrão do Prisma: guarda um `cuid()`,
  /// que tem 25 caracteres. Numa tabela deste volume, a diferença aparece no
  /// tamanho dos DOIS índices compostos abaixo, não só na coluna.
  articleId String? @db.VarChar(40)

  /// Para 'article.link': a matéria de DESTINO do clique. É o par que responde
  /// "o que puxa leitura para o quê" — a métrica que justifica (ou condena) o
  /// bloco "Leia também" no meio do texto.
  targetArticleId String? @db.VarChar(40)

  /// Para 'affiliate.click': a oferta clicada.
  offerId String? @db.VarChar(40)

  /// Para 'ad.click': o identificador do slot ('artigo-meio', 'artigo-fim'...),
  /// como definido em `lib/ads.ts`. Serve para comparar posições entre si.
  slotId String? @db.VarChar(64)

  createdAt DateTime @default(now())

  // Índice da tela por matéria: "eventos desta matéria, deste tipo, na janela".
  // A ordem das colunas é a da seletividade decrescente e casa com o `WHERE`
  // real da consulta — índice cuja ordem não casa com a consulta é índice que
  // não é usado, e o `EXPLAIN` é o único jeito de descobrir isso.
  @@index([articleId, kind, createdAt])
  // Índice da visão do SITE INTEIRO (só administrador): "todos os cliques em
  // afiliado dos últimos 30 dias", sem passar por matéria.
  @@index([kind, createdAt])
}

/// Log de eventos do pipeline editorial.
///
/// POR QUE NÃO USAR SÓ O GA4: o GA4 mede o comportamento do LEITOR. Ele não
/// sabe quando um score cruzou 80, quanto tempo a redação levou para publicar,
/// nem se o algoritmo acertou. Esses KPIs nascem dentro do nosso pipeline e
/// precisam de instrumentação própria — daí esta tabela.
model PipelineEvent {
  id String @id @default(cuid())

  /// 'topic.discovered' | 'topic.scored' | 'topic.became_hot' | 'topic.claimed'
  /// | 'topic.published' | 'connector.failed' | 'push.sent' | 'override.applied'
  eventType String

  topicId     String?
  articleId   String?
  connectorId String?
  actorId     String?

  /// Payload específico do evento (score anterior/novo, duração, erro...).
  ///
  /// ⚠ Mesmo aviso de `Author.socialLinks`: o `@default("{}")` NÃO chega ao
  /// banco no conector MySQL (prisma#23250). Pela aplicação é invisível; por SQL
  /// cru, é uma violação de NOT NULL esperando acontecer.
  payload Json @default("{}")

  /// Duração em ms, quando o evento representa um intervalo
  /// (ex.: time-to-publish). Campo dedicado para permitir agregação eficiente.
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([eventType, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([createdAt])
}

/// Execução do pipeline — uma linha por ciclo, para monitorar saúde e custo.
model PipelineRun {
  id String @id @default(cuid())

  /// 'discovery' | 'enrichment' | 'rescore' | 'full'
  stage String

  status String @default("running")

  topicsDiscovered Int @default(0)
  topicsScored     Int @default(0)
  topicsPromoted   Int @default(0)

  connectorsRun    Int @default(0)
  connectorsFailed Int @default(0)

  /// Custo estimado em centavos de dólar das chamadas pagas do ciclo.
  /// Com X e Reddit cobrando por chamada, custo é métrica operacional de
  /// primeira classe — não uma surpresa no fim do mês.
  estimatedCostCents Float @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  // Stack trace do ciclo que falhou. `Text` — ver `ConnectorHealth.lastError`.
  error      String?   @db.Text

  @@index([stage, startedAt(sort: Desc)])
}

/// Trilha de auditoria de ações humanas no painel.
/// Override manual precisa de responsável e justificativa registrados: é o que
/// permite, depois, distinguir "o algoritmo errou" de "o editor discordou".
model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   Author? @relation(fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   String

  before Json?
  after  Json?
  // Justificativa digitada por um humano. É a razão de ser desta tabela:
  // truncá-la esvaziaria a própria trilha de auditoria.
  reason String? @db.Text

  ipHash    String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}
