// =============================================================================
// MODELO DE DADOS DO CANALNERD
// =============================================================================
//
// Banco escolhido: PostgreSQL. As razões (detalhadas no ADR 0002 do README):
//   - O domínio é fortemente relacional: artigo N:N franquia, artigo N:N tag,
//     score 1:N histórico. Em documento, "todos os artigos da franquia X
//     ordenados por score" vira agregação cara ou duplicação de dados.
//   - Precisamos de séries temporais de score com consultas por janela
//     (últimas 24h). Índices B-tree compostos resolvem isso muito bem.
//   - `jsonb` cobre a parte genuinamente sem esquema (payload bruto de sinal),
//     então não pagamos o preço de um segundo banco só por isso.
//
// CONVENÇÕES ADOTADAS:
//   - `cuid()` como chave primária em vez de autoincremento: IDs sequenciais
//     vazam volume de negócio (o concorrente lê /article/1042 e sabe quantas
//     matérias publicamos) e atrapalham inserção distribuída.
//   - Todo campo consultado em listagem tem índice explícito. Este portal vive
//     de ordenação por score e por data; sem índice, a home degrada exatamente
//     no pico de tráfego, que é quando ela não pode degradar.
//   - Datas sempre em UTC; a conversão para o fuso do leitor é feita na borda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// TAXONOMIA — categorias, franquias e tags
// =============================================================================

model Category {
  id          String @id @default(cuid())
  // O slug é a URL pública (/categoria/games). `@unique` porque a URL é
  // identidade: duas categorias com o mesmo slug seria conteúdo duplicado,
  // que o Google pune.
  slug        String @unique
  name        String
  shortName   String
  description String
  accentColor String @default("#7C3AED")

  // Prioridade de monitoramento (1 = máxima). O pipeline usa para alocar o
  // orçamento de chamadas de API quando a quota aperta.
  monitoringPriority Int @default(5)
  launchPhase        Int @default(1)
  affiliateWeight    Float @default(0.5)

  // Campos de SEO sobrescrevíveis. Quando nulos, o front gera a partir de
  // name/description — ter o override permite ao editor otimizar sem deploy.
  seoTitle       String?
  seoDescription String?

  articles Article[]
  topics   Topic[]
  franchises Franchise[]
  subcategories Subcategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monitoringPriority])
}

/// Sub-categoria de UM nível dentro de uma editoria. Hoje: Hardware ⊂ Tech.
///
/// POR QUE UMA TABELA, E NÃO UMA TAG (ver core/taxonomy.ts para o racional
/// completo): a sub-categoria tem URL indexável própria
/// (/categoria/tech/hardware), entra no menu e precisa ser FILTRÁVEL por chave
/// estrangeira. Filtrar "todos os artigos de hardware" por texto de tag é lento,
/// frágil (basta alguém escrever "Hardwares") e não sobrevive a renomeação.
///
/// Assim como as categorias, vive no código (`SUBCATEGORIES` em core/taxonomy)
/// e é MATERIALIZADA aqui pelo seed — o mesmo padrão de "seed tipado", pelos
/// mesmos motivos: são poucas, estáveis e mudam junto com rota e menu.
model Subcategory {
  id   String @id @default(cuid())
  /// Único DENTRO da categoria-mãe, não globalmente: no futuro pode existir
  /// "hardware" em Tech e "hardware" em Games sem colisão de identidade.
  slug String
  name String
  description String @default("")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Ver comentário em Category.affiliateWeight: controla SÓ densidade de bloco
  /// na UI e priorização humana de pauta. NUNCA entra no cálculo de score.
  affiliateWeight Float @default(0.5)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([slug])
}

/// Franquia/fandom (Star Wars, Zelda, One Piece). Motor de retenção do produto.
model Franchise {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @default("")

  // Nomes alternativos usados pelos conectores para casar menções.
  // Array nativo do Postgres: evita uma tabela de junção para um dado que é
  // sempre lido junto do pai e nunca consultado isoladamente.
  aliases String[] @default([])

  heroImageUrl String?
  logoUrl      String?

  primaryCategoryId String
  primaryCategory   Category @relation(fields: [primaryCategoryId], references: [id])

  /// Índice de afinidade da NOSSA audiência (1.0 = média do site).
  /// Recalculado por job a partir de pageviews/tempo de sessão históricos.
  /// É o sinal proprietário que nenhum concorrente consegue copiar.
  audienceAffinityIndex Float @default(1.0)
  followerCount         Int   @default(0)

  articles ArticleFranchise[]
  topics   TopicFranchise[]
  releases ReleaseEvent[]
  follows  FranchiseFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryCategoryId])
  @@index([audienceAffinityIndex])
}

model Tag {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  /// 'character' | 'person' | 'studio' | 'event' | 'generic'
  kind     String @default("generic")
  articles ArticleTag[]

  createdAt DateTime @default(now())

  @@index([kind])
}

// =============================================================================
// AUTORES — entidades de primeira classe por causa de E-E-A-T
// =============================================================================

model Author {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  email  String @unique
  bio    String @default("")
  avatarUrl String?
  role   String @default("Redator")

  /// Links sociais e credenciais viram schema.org/Person com `sameAs`.
  /// É assim que o Google conecta o autor a uma identidade verificável — peça
  /// central de E-E-A-T em nicho de notícias.
  socialLinks Json @default("[]")
  expertiseAreas String[] @default([])

  /// Papel no sistema. Controla o acesso ao painel editorial.
  /// 'admin' | 'editor' | 'writer'
  systemRole String @default("writer")
  isActive   Boolean @default(true)

  articles Article[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// TÓPICOS — o que o pipeline descobre antes de existir artigo
// =============================================================================

/// Um TÓPICO é um fato do mundo detectado pelo pipeline.
/// Um ARTIGO é o nosso conteúdo sobre ele. Ver comentário em core/domain.ts
/// para o motivo de serem tabelas separadas.
model Topic {
  id      String @id @default(cuid())
  /// Termo canônico usado nas consultas aos conectores.
  query   String
  aliases String[] @default([])
  title   String
  summary String @default("")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  franchises TopicFranchise[]

  // ---- Proveniência ----
  sourceUrl  String?
  sourceName String?
  /// Tier de autoridade da fonte: 'official' | 'tier1Press' | ... | 'unverified'
  sourceTier String @default("unverified")

  /// Hash de deduplicação. Três feeds noticiando o mesmo anúncio precisam virar
  /// UM tópico, senão o mesmo assunto ocupa a home inteira e o orçamento de API
  /// é gasto três vezes. Ver services/curator/src/pipeline/dedupe.ts.
  dedupeHash String @unique

  // ---- Score (valores atuais, desnormalizados de propósito) ----
  //
  // Estes campos duplicam o último registro de ScoreSnapshot. É desnormalização
  // consciente: a home e o /trending ordenam por score a cada requisição, e
  // fazer isso com subquery no histórico seria caro justamente no pico de
  // tráfego. Gravamos os dois — histórico para análise, atual para leitura.
  currentScore    Float  @default(0)
  currentBand     String @default("EVERGREEN")
  /// Variação do score na última hora (ver comentário equivalente em Article).
  scoreDelta1h    Float  @default(0)
  seoOpportunity  Float  @default(0)
  confidence      Float  @default(0)
  termType        String @default("mid")
  emotionalTriggers String[] @default([])
  requiresHumanReview Boolean @default(false)
  scoreSummary    String @default("")
  weightsVersion  String @default("")

  // ---- Override humano (o humano sempre vence o algoritmo) ----
  manualScoreOverride Float?
  manualOverrideReason String?
  manualOverrideById   String?
  manualOverrideAt     DateTime?

  /// 'new' | 'assigned' | 'published' | 'dismissed'
  status String @default("new")

  // ---- Instrumentação editorial (KPIs que analytics não fornece) ----
  firstSeenAt   DateTime @default(now())
  lastScoredAt  DateTime?
  /// Momento em que o score cruzou 80 pela primeira vez. É o T-zero do
  /// cronômetro de time-to-publish, o KPI editorial mais importante.
  becameHotAt   DateTime?
  /// Quando um jornalista assumiu a pauta.
  claimedAt     DateTime?
  claimedById   String?
  /// Quando o primeiro artigo derivado foi publicado.
  publishedAt   DateTime?

  articles       Article[]
  scoreSnapshots ScoreSnapshot[]
  signalReadings SignalReading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice principal do painel e do /trending: "tópicos ativos por score".
  @@index([status, currentScore(sort: Desc)])
  @@index([currentBand, becameHotAt])
  @@index([categoryId, currentScore(sort: Desc)])
  @@index([firstSeenAt])
}

model TopicFranchise {
  topicId     String
  franchiseId String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@id([topicId, franchiseId])
  @@index([franchiseId])
}

// =============================================================================
// HISTÓRICO DE SCORE E SINAIS — a memória que permite recalibrar
// =============================================================================

/// Fotografia do score num instante. Série temporal.
///
/// Guardamos TODOS os cálculos, não só as mudanças de faixa. É o que permite
/// reconstruir a curva de um tópico ("subiu de 40 para 85 em 2h") e reprocessar
/// o passado com pesos novos. É a tabela que mais cresce do sistema — a política
/// de retenção está documentada no README (resumo: detalhe por 90 dias, depois
/// agregado horário).
model ScoreSnapshot {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  score          Float
  band           String
  seoOpportunity Float
  confidence     Float

  /// Contribuição de cada dimensão, para o painel explicar o score.
  /// `Json` porque o conjunto de dimensões evolui com o tempo e não queremos
  /// migração de schema a cada sinal novo.
  contributions  Json
  weightsVersion String

  /// `true` quando este cálculo foi feito com pesos candidatos, em paralelo com
  /// os de produção (shadow scoring). Permite comparar modelos sem afetar o site.
  isShadow Boolean @default(false)

  calculatedAt DateTime @default(now())

  @@index([topicId, calculatedAt(sort: Desc)])
  @@index([calculatedAt])
  @@index([weightsVersion, isShadow])
}

/// Medição individual de um conector — o dado bruto, antes da agregação.
///
/// Por que guardar em nível tão granular? Duas razões concretas:
///  1) Depurar conector: "o Reddit está devolvendo 0 desde terça?"
///  2) Recalibrar com dados brutos, e não com valores já achatados pelos
///     pesos antigos — sem isso, a recalibração fica presa às escolhas passadas.
model SignalReading {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  connectorId String
  dimension   String
  value       Float
  rawValue    String?
  confidence  Float
  explanation String?

  /// Payload original da API, para auditoria e reprocessamento.
  rawPayload Json?

  observedAt DateTime @default(now())

  @@index([topicId, observedAt(sort: Desc)])
  @@index([connectorId, observedAt(sort: Desc)])
}

/// Saúde dos conectores — alimenta o circuit breaker e o painel de status.
model ConnectorHealth {
  id          String @id @default(cuid())
  connectorId String @unique

  isEnabled Boolean @default(true)
  /// 'closed' = normal | 'open' = suspenso por falhas | 'half-open' = testando
  circuitState String @default("closed")

  consecutiveFailures Int @default(0)
  totalRuns           Int @default(0)
  totalFailures       Int @default(0)
  avgDurationMs       Float @default(0)

  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError     String?
  /// Quando o circuito aberto deve ser testado novamente.
  circuitOpenUntil DateTime?

  /// Consumo do orçamento de chamadas pagas no ciclo corrente.
  callsThisPeriod   Int @default(0)
  periodResetAt     DateTime?

  updatedAt DateTime @updatedAt
}

// =============================================================================
// ARTIGOS
// =============================================================================

model Article {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String @default("")
  /// Corpo em Markdown (ver ADR 0005).
  content String @default("")

  /// 'suggested' | 'claimed' | 'draft' | 'in-review' | 'published' | 'archived'
  status String @default("draft")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  /// Sub-categoria (ex.: Hardware dentro de Tech). Opcional: a maioria dos
  /// artigos vive direto na editoria.
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  franchises ArticleFranchise[]
  tags       ArticleTag[]

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  /// Tópico que originou o artigo. Opcional: matéria de pauta própria não vem
  /// do pipeline, e forçar um tópico sintético só sujaria os dados.
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])

  coverImageUrl String?
  coverImageAlt String?

  /// Vídeo associado (trailer) — vira schema.org/VideoObject.
  videoUrl          String?
  videoThumbnailUrl String?
  videoDurationSeconds Int?

  // ---- SEO ----
  seoTitle       String?
  seoDescription String?
  /// Canonical externo, para republicações licenciadas.
  canonicalUrl   String?
  noIndex        Boolean @default(false)

  isBreaking Boolean @default(false)
  readingMinutes Int @default(1)

  // ---- Contrato de apresentação (exigido por design/README.md, seção 2) ----
  /// Formato do conteúdo: define o template do miolo no front.
  /// 'breaking' | 'live' | 'trailer' | 'review' | 'listicle' | 'theory'
  /// | 'comparison' | 'guide'
  format String @default("breaking")

  /// Cobertura ao vivo em andamento: liga o ponto pulsante e a timeline.
  isLive       Boolean @default(false)
  updatesCount Int     @default(0)

  /// Liga o bloco de revelação por escolha (blur + "Mostrar mesmo assim").
  /// Prevenção de erro para o público de séries e anime.
  hasSpoiler Boolean @default(false)

  /// Resumo em 3 a 5 bullets. OBRIGATÓRIO em 'breaking' e 'review' — a
  /// validação vive em core/presentation.ts e é aplicada no painel editorial.
  tldr String[] @default([])

  /// Dados de análise, quando format = 'review'. Json porque a estrutura
  /// (nota, prós, contras) só existe para um formato entre oito — colunas
  /// dedicadas ficariam nulas em 90% das linhas.
  reviewData Json?

  /// Atualizações da cobertura ao vivo (live blog).
  liveUpdates LiveUpdate[]

  // ---- Score ----
  /// Congelado no instante da publicação. É o "previsto" do KPI de precisão —
  /// e por isso NUNCA deve ser atualizado depois.
  scoreAtPublish Float?
  /// Score vivo, recalculado continuamente. Permite que um trailer que viralize
  /// 3h depois de publicado suba sozinho para o hero da home.
  currentScore   Float @default(0)
  currentBand    String @default("EVERGREEN")
  /// Variação do score na última hora. Alimenta a seta e o "+38" do design.
  /// Desnormalizado (em vez de calculado por subquery no histórico) porque a
  /// home exibe isso em todos os cards e a consulta roda a cada requisição
  /// não cacheada — justamente no pico de tráfego.
  scoreDelta1h   Float @default(0)
  scoreUpdatedAt DateTime?

  // ---- Métricas reais (o "observado" do KPI de precisão) ----
  viewCount      Int @default(0)
  /// Pageviews nas primeiras 24h. Congelado por job após a janela fechar.
  pageviews24h   Int?
  avgTimeOnPageSeconds Float?
  scrollDepthAvg Float?
  shareCount     Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Monetização (ver models AffiliateOffer / ArticleAffiliateOffer) ----
  /// DERIVADO da relação `affiliateOffers`. NUNCA editável pelo editor.
  ///
  /// A fonte da verdade é a RELAÇÃO; esta coluna é um índice desnormalizado,
  /// mantido exclusivamente por `syncAffiliateFlag()` em packages/db. Existe
  /// pelo mesmo motivo de `currentScore` no mesmo model: permitir filtrar
  /// "artigos com afiliado" em listagens sem um JOIN + COUNT por linha.
  ///
  /// Se algum dia esta coluna divergir da relação, quem vale é a relação — a
  /// camada de leitura recalcula o valor a partir dela ao montar o artigo.
  hasAffiliateLinks Boolean @default(false)

  affiliateOffers ArticleAffiliateOffer[]

  pushNotifications PushNotification[]
  comments          Comment[]

  // Índice da home e das páginas de categoria: publicados, mais recentes.
  @@index([status, publishedAt(sort: Desc)])
  // Índice do hero/trending: publicados, maior score.
  @@index([status, currentScore(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  // Índice da aba de sub-categoria (/categoria/tech/hardware).
  @@index([subcategoryId, status, publishedAt(sort: Desc)])
  @@index([topicId])
  @@index([authorId])
}

model ArticleFranchise {
  articleId   String
  franchiseId String
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@id([articleId, franchiseId])
  // Índice do hub de franquia: "todos os artigos de Star Wars".
  @@index([franchiseId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// Atualização de cobertura ao vivo (live blog).
///
/// Tabela separada, e não um array de Json no artigo, por três motivos:
///  1) Cada atualização tem timestamp próprio e precisa ser ordenável.
///  2) Publicar uma atualização não pode reescrever o corpo inteiro do artigo
///     (que está em cache de CDN — reescrever invalidaria tudo a cada minuto).
///  3) Permite buscar "só as novidades desde X" para atualização incremental
///     no cliente, sem rebaixar a página inteira.
model LiveUpdate {
  id        String @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  content     String
  isHighlight Boolean @default(false)
  authorName  String?

  createdAt DateTime @default(now())

  @@index([articleId, createdAt(sort: Desc)])
}

// =============================================================================
// MONETIZAÇÃO — ofertas de afiliado
// =============================================================================
//
// PREMISSA DE MODELAGEM: a rede de afiliados AINDA NÃO FOI ESCOLHIDA.
//
// Isso muda tudo na hora de desenhar as tabelas. O erro clássico aqui é modelar
// em cima da primeira integração ("amazonAsin", "awinMerchantId") e descobrir,
// seis meses depois, que a metade do schema não serve para a rede escolhida —
// com dados de produção dentro. O custo dessa migração é alto e o prazo, ruim.
//
// A modelagem adotada é a do DADO EDITORIAL, não a do dado da rede:
//   - loja/varejista é TEXTO LIVRE (fase 1: o editor digita "Kabum");
//   - `network` e `externalId` já existem, vazios, esperando a fase 2, quando
//     um integrador passa a preencher e sincronizar preço por API;
//   - nada no schema pressupõe uma rede específica.
//
// Resultado: a fase 1 (cadastro manual pelo editor) e a fase 2 (sincronização
// automática) usam AS MESMAS TABELAS. Plugar a API não redesenha nada — só
// preenche colunas que já existem.

/// Oferta de produto com link de afiliado.
///
/// A oferta é uma entidade PRÓPRIA e não uma coluna do artigo, porque o mesmo
/// produto ("RTX 5090 na Loja X") aparece em vários artigos (review, comparativo,
/// "melhores placas de 2026"). Com colunas no artigo, atualizar o preço exigiria
/// achar e editar N artigos — e algum ficaria para trás, exibindo preço velho.
/// Aqui, atualiza-se UMA linha e todos os artigos acompanham.
model AffiliateOffer {
  id String @id @default(cuid())

  productName  String
  /// Loja/varejista. Texto livre por decisão consciente (ver bloco acima).
  retailerName String
  brand        String?

  /// Preço em CENTAVOS, como inteiro.
  ///
  /// NUNCA `Float` para dinheiro: aritmética binária de ponto flutuante não
  /// representa 0,1 exatamente, e o erro se acumula em somas e comparações.
  /// Nulo é estado legítimo: "oferta cadastrada, preço ainda não conferido".
  priceCents Int?
  currency   String @default("BRL")

  /// URL final de afiliado (já com o código de rastreio do programa).
  /// Sanitizada na renderização — ver apps/web/src/lib/safe-url.ts.
  offerUrl String

  /// Categoria do PROGRAMA (hardware, console, jogo...). Ver core/monetization.
  programCategory String @default("outro")

  /// Rede de afiliados. Nulo na fase 1 (cadastro manual); preenchido na fase 2.
  network    String?
  /// Identificador do produto NA REDE (ASIN, SKU, offer id). Fase 2.
  externalId String?

  imageUrl String?
  /// 'in-stock' | 'out-of-stock' | 'unknown'
  availability String @default("unknown")

  /// 'affiliate' | 'sponsored'.
  ///
  /// Hoje só usamos 'affiliate'. A coluna já aceita 'sponsored' porque o dono
  /// do site pediu que o schema não travasse a evolução para publieditorial —
  /// a LÓGICA de patrocinado não está implementada, só o vocabulário.
  disclosureKind String @default("affiliate")

  /// Quando o PREÇO foi atualizado pela última vez.
  ///
  /// Coluna separada de `updatedAt` de propósito. `updatedAt` responde "quando
  /// a linha mudou" (inclusive por uma correção de digitação no nome). O editor
  /// e o leitor precisam de outra resposta: "esse preço é de quando?".
  /// Misturar as duas faria uma correção de texto "rejuvenescer" um preço de
  /// três semanas atrás — exatamente o erro que este campo existe para evitar.
  priceUpdatedAt DateTime?
  /// Última verificação (mesmo sem mudança de preço). Fase 2, alimentado pelo job.
  lastCheckedAt  DateTime?

  /// Desligar > apagar: uma oferta encerrada precisa sumir do site sem levar
  /// junto o histórico de qual artigo a exibia (auditoria e prestação de contas).
  isActive Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  articles ArticleAffiliateOffer[]

  // Índice da tela de afiliados do painel: "ofertas ativas com preço mais velho
  // primeiro" — é a fila de trabalho do editor.
  @@index([isActive, priceUpdatedAt])
  @@index([programCategory])
  @@index([disclosureKind])
  @@index([network, externalId])
}

/// Vínculo N:N entre artigo e oferta.
///
/// Tabela de junção EXPLÍCITA (e não uma relação implícita do Prisma) porque o
/// vínculo carrega dados próprios: posição no bloco, destaque e quem vinculou.
/// Vínculo de afiliado é ação HUMANA e auditável — o `services/curator` (a
/// curadoria automática) não encosta nesta tabela.
model ArticleAffiliateOffer {
  articleId String
  offerId   String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  offer     AffiliateOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// Ordem de exibição no bloco. O editor decide o que vem primeiro — não o
  /// preço, não a comissão. Ordenar por comissão seria monetização governando
  /// conteúdo, que é justamente o que este projeto separa.
  position Int @default(0)
  /// "Nossa escolha": destaque visual dentro do bloco.
  isHighlighted Boolean @default(false)
  /// Rótulo curto opcional ("melhor custo-benefício", "top de linha").
  label String?

  addedById String?
  createdAt DateTime @default(now())

  @@id([articleId, offerId])
  @@index([offerId])
  @@index([articleId, position])
}

// =============================================================================
// CALENDÁRIO DE LANÇAMENTOS — base própria para o sinal de sazonalidade
// =============================================================================

/// Datas conhecidas de estreias (filmes, jogos, temporadas de anime).
/// Alimenta o sinal `releaseProximity`: notícia perto de lançamento confirmado
/// vale mais. Também vira conteúdo próprio ("o que estreia em setembro").
model ReleaseEvent {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  /// 'movie' | 'series-season' | 'game' | 'anime-season' | 'comic' | 'event'
  kind String

  releaseDate DateTime
  /// `false` para datas anunciadas como "2027" ou janelas vagas — o sinal
  /// pondera menos quando a data não é firme.
  isConfirmed Boolean @default(true)

  platform String?
  region   String @default("BR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([releaseDate])
  @@index([franchiseId, releaseDate])
}

// =============================================================================
// FUNIL DE AUDIÊNCIA — newsletter, push, comunidade
// =============================================================================

/// Assinante de newsletter com DOUBLE OPT-IN.
///
/// SEGURANÇA E CONFORMIDADE (LGPD): o duplo opt-in não é firula de marketing.
/// Ele é (a) prova de consentimento, exigida pela LGPD, (b) proteção contra
/// cadastro malicioso de e-mails de terceiros e (c) o que mantém a reputação
/// de envio do domínio — sem ele, um bot inscreve mil endereços inválidos, os
/// bounces disparam e todo o domínio vai para spam.
model Subscriber {
  id    String @id @default(cuid())
  email String @unique

  /// 'pending' | 'confirmed' | 'unsubscribed' | 'bounced'
  status String @default("pending")

  /// Hash do token de confirmação (nunca o token em claro).
  /// Mesmo princípio de senha: se o banco vazar, o atacante não consegue
  /// confirmar inscrições alheias com os hashes.
  confirmationTokenHash String?
  confirmationExpiresAt DateTime?
  confirmedAt           DateTime?

  /// Token de descadastro, para o link de 1 clique exigido por lei/RFC 8058.
  unsubscribeTokenHash String?
  unsubscribedAt       DateTime?

  /// Preferências de conteúdo — franquias e categorias seguidas.
  preferredCategories String[] @default([])

  // ---- Auditoria de consentimento (LGPD) ----
  /// IP e user-agent do momento do opt-in. Guardados por serem a prova do
  /// consentimento. IP é dado pessoal: incluído na política de retenção.
  signupIpHash    String?
  signupUserAgent String?
  signupSource    String @default("site")

  // ---- Métricas de engajamento ----
  emailsSent    Int @default(0)
  emailsOpened  Int @default(0)
  emailsClicked Int @default(0)
  lastOpenedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Inscrição de Web Push (Push API / service worker).
model PushSubscription {
  id String @id @default(cuid())

  /// Endpoint único fornecido pelo navegador.
  endpoint String @unique
  /// Chaves de criptografia da Push API. São específicas do par
  /// navegador+site e inúteis fora dele, mas ainda assim tratadas como segredo.
  p256dh String
  auth   String

  userAgent String?
  /// Segmentação: só quero push de Games? Só de uma franquia?
  preferredCategories String[] @default([])
  preferredFranchises String[] @default([])
  /// Só recebe push de score >= este valor. Padrão 80 = apenas QUENTE.
  minScoreThreshold Int @default(80)

  isActive Boolean @default(true)
  /// Endpoints expiram; após 410/404 do serviço de push, desativamos.
  lastFailureAt DateTime?
  failureCount  Int @default(0)

  notificationsSent    Int @default(0)
  notificationsClicked Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries PushDelivery[]

  @@index([isActive, minScoreThreshold])
}

/// Campanha de push disparada para um artigo.
model PushNotification {
  id        String @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  title String
  body  String
  iconUrl String?
  url     String

  /// 'automatic' = disparado pelo score | 'manual' = editor apertou o botão
  trigger String @default("manual")
  scoreAtTrigger Float?
  approvedById   String?

  /// 'pending' | 'sending' | 'sent' | 'failed'
  status String @default("pending")

  recipientCount Int @default(0)
  deliveredCount Int @default(0)
  clickedCount   Int @default(0)

  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  deliveries PushDelivery[]

  @@index([status, scheduledFor])
  @@index([articleId])
}

model PushDelivery {
  id             String @id @default(cuid())
  notificationId String
  notification   PushNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// 'sent' | 'failed' | 'expired'
  status    String
  clickedAt DateTime?
  error     String?
  createdAt DateTime @default(now())

  @@unique([notificationId, subscriptionId])
  @@index([subscriptionId])
}

/// Leitor que segue uma franquia — sinal de retenção e base de segmentação.
model FranchiseFollow {
  id          String @id @default(cuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  /// Identificador anônimo do visitante (cookie primário), quando não há login.
  visitorId String
  createdAt DateTime @default(now())

  @@unique([franchiseId, visitorId])
  @@index([visitorId])
}

// =============================================================================
// COMENTÁRIOS COM IDENTIDADE SOCIAL (Discord / Google)
// =============================================================================
//
// LGPD — MINIMIZAÇÃO DE DADOS é o princípio que desenha estas três tabelas.
// A pergunta feita em cada campo foi: "se este dado vazar amanhã, o que
// acontece com o leitor?" — e, antes dela: "a funcionalidade existe sem ele?".
// Ver o quadro completo em packages/core/src/community.ts.
//
// O que NÃO existe aqui, de propósito:
//   - token de acesso / refresh token do OAuth. Usamos o token uma vez, para
//     ler o perfil, e descartamos. Guardar token é guardar acesso à conta
//     alheia: risco enorme, valor zero para um sistema de comentários.
//   - ID bruto da conta no provedor. Só o hash. Precisamos RECONHECER a mesma
//     pessoa, não IDENTIFICÁ-LA fora do nosso site.
//   - e-mail em claro. Só o hash, e apenas para bloquear o reincidente que
//     volta pelo outro provedor.

/// Identidade de um leitor que comenta, vinda de um provedor OAuth.
model CommentAuthor {
  id String @id @default(cuid())

  /// 'discord' | 'google'
  provider String
  /// HASH do ID da conta no provedor (com sal da aplicação).
  ///
  /// Por que hash e não o valor bruto: o ID do Discord/Google é um
  /// identificador estável e público-adjacente — com ele em claro, um vazamento
  /// do nosso banco permitiria cruzar cada comentário com o perfil real da
  /// pessoa em outras bases. Do nosso lado, tudo que precisamos é comparar
  /// igualdade ("é o mesmo sujeito de ontem?"), e hash faz isso perfeitamente.
  providerAccountHash String

  /// Nome público. Único dado pessoal guardado em claro — porque a finalidade
  /// (assinar o comentário) É exibi-lo.
  displayName String
  /// URL do avatar no CDN do provedor. Nunca baixamos nem re-hospedamos a
  /// imagem: isso criaria uma cópia de dado pessoal que teríamos de apagar
  /// depois, por nada.
  avatarUrl String?
  /// HASH do e-mail. Usado só para reconhecer reincidente banido que volta pelo
  /// outro provedor. Nunca para enviar e-mail — para isso existe o Subscriber,
  /// com consentimento próprio e double opt-in.
  emailHash String?

  /// Bloqueio pela moderação. Bloqueado não posta e não vê botão de login.
  isBlocked   Boolean @default(false)
  blockedAt   DateTime?
  blockReason String?

  /// Contadores de reputação — a base da "escada de confiança": o primeiro
  /// comentário de uma conta nova entra em moderação prévia; depois de
  /// aprovado, os seguintes publicam direto. É o que impede o drive-by de
  /// conta descartável sem transformar a redação em fila de aprovação.
  approvedCount Int @default(0)

  comments Comment[]
  sessions CommentSession[]

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // Identidade = (provedor, conta). O par é único; o mesmo humano com Discord
  // E Google vira duas linhas — e tudo bem: não somos rede social, não fundimos
  // identidades (fundir exigiria guardar mais dado pessoal, não menos).
  @@unique([provider, providerAccountHash])
  @@index([emailHash])
  @@index([isBlocked])
}

/// Sessão de leitor logado.
///
/// POR QUE SESSÃO OPACA NO BANCO, E NÃO JWT NO COOKIE:
/// o caso de uso mais importante da moderação é "bane esse sujeito AGORA".
/// Com JWT, o token continua válido até expirar — não há revogação sem manter
/// uma lista de bloqueio, que é um banco de sessões pior. Com sessão opaca,
/// apagar a linha encerra o acesso no próximo clique.
/// Guardamos o HASH do token, jamais o token: é o mesmo padrão já usado nos
/// tokens de newsletter (ver apps/web/src/server/security.ts).
model CommentSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  authorId String
  author   CommentAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  userAgent String?
  ipHash    String?

  createdAt DateTime @default(now())

  @@index([authorId])
  // Suporta a limpeza periódica de sessões expiradas.
  @@index([expiresAt])
}

/// Comentário.
model Comment {
  id        String @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// Autor autenticado. Opcional apenas para não perder os comentários legados
  /// do modelo anterior (nome + e-mail); todo comentário NOVO exige login.
  authorAccountId String?
  authorAccount   CommentAuthor? @relation(fields: [authorAccountId], references: [id], onDelete: Cascade)

  /// Snapshot do nome no momento da publicação.
  ///
  /// Redundante com `CommentAuthor.displayName`? Não: se a pessoa trocar o nome
  /// no Discord para algo ofensivo, todos os comentários antigos dela mudariam
  /// retroativamente. O snapshot congela o que foi publicado — e a moderação
  /// continua conseguindo agir sobre a conta.
  authorName  String
  authorEmailHash String?
  /// Conteúdo em texto puro. NUNCA renderizar como HTML — ver ADR 0005 (XSS).
  content     String

  /// 'pending' | 'approved' | 'rejected' | 'spam'
  status String @default("pending")

  // ---- Trilha de moderação ----
  /// Quem removeu/aprovou e por quê. Sem isso, "por que meu comentário sumiu?"
  /// não tem resposta, e uma remoção contestada vira palavra contra palavra.
  moderatedAt     DateTime?
  moderatedBy     String?
  moderationNote  String?

  parentId String?
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  /// Hash do IP para rate limiting e antiabuso, sem guardar o IP em claro.
  ipHash String?
  upvotes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorAccountId])
}

// =============================================================================
// INSTRUMENTAÇÃO INTERNA — KPIs que o GA4 não entrega
// =============================================================================

/// Log de eventos do pipeline editorial.
///
/// POR QUE NÃO USAR SÓ O GA4: o GA4 mede o comportamento do LEITOR. Ele não
/// sabe quando um score cruzou 80, quanto tempo a redação levou para publicar,
/// nem se o algoritmo acertou. Esses KPIs nascem dentro do nosso pipeline e
/// precisam de instrumentação própria — daí esta tabela.
model PipelineEvent {
  id String @id @default(cuid())

  /// 'topic.discovered' | 'topic.scored' | 'topic.became_hot' | 'topic.claimed'
  /// | 'topic.published' | 'connector.failed' | 'push.sent' | 'override.applied'
  eventType String

  topicId   String?
  articleId String?
  connectorId String?
  actorId   String?

  /// Payload específico do evento (score anterior/novo, duração, erro...).
  payload Json @default("{}")

  /// Duração em ms, quando o evento representa um intervalo
  /// (ex.: time-to-publish). Campo dedicado para permitir agregação eficiente.
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([eventType, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([createdAt])
}

/// Execução do pipeline — uma linha por ciclo, para monitorar saúde e custo.
model PipelineRun {
  id String @id @default(cuid())

  /// 'discovery' | 'enrichment' | 'rescore' | 'full'
  stage String

  status String @default("running")

  topicsDiscovered Int @default(0)
  topicsScored     Int @default(0)
  topicsPromoted   Int @default(0)

  connectorsRun     Int @default(0)
  connectorsFailed  Int @default(0)

  /// Custo estimado em centavos de dólar das chamadas pagas do ciclo.
  /// Com X e Reddit cobrando por chamada, custo é métrica operacional de
  /// primeira classe — não uma surpresa no fim do mês.
  estimatedCostCents Float @default(0)

  startedAt  DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?

  @@index([stage, startedAt(sort: Desc)])
}

/// Trilha de auditoria de ações humanas no painel.
/// Override manual precisa de responsável e justificativa registrados: é o que
/// permite, depois, distinguir "o algoritmo errou" de "o editor discordou".
model AuditLog {
  id      String @id @default(cuid())
  actorId String?
  actor   Author? @relation(fields: [actorId], references: [id])

  action     String
  entityType String
  entityId   String

  before Json?
  after  Json?
  reason String?

  ipHash String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}
